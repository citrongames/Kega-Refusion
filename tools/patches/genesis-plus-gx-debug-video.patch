+++ b/libretro/libretro.c
@@ -3713,6 +3713,50 @@
 
 /* Hardware identification and cached decoded CD header for achievements.
  * Header retrieval never seeks the running drive or decodes audio. */
+/* Local output masks are outside emulated/serialized state. */
+uint32_t kega_debug_video_mask = 0;
+uint64_t kega_debug_audio_mask = 0;
+uint8_t kega_debug_audio_gain[38] = {100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100};
+uint32_t kega_debug_backdrop = 0xff00ff;
+
+RETRO_API void retro_kegarefusion_debug_masks(uint32_t video, uint64_t audio)
+{
+   kega_debug_video_mask = video & 63u;
+   kega_debug_audio_mask = audio & ((UINT64_C(1) << 38) - 1);
+}
+RETRO_API void retro_kegarefusion_debug_gain(unsigned channel, unsigned percent)
+{
+   if (channel < 38) kega_debug_audio_gain[channel] = percent > 100 ? 100 : percent;
+}
+RETRO_API void retro_kegarefusion_debug_backdrop(uint32_t rgb)
+{
+   kega_debug_backdrop = rgb & 0xffffff;
+}
+RETRO_API bool retro_kegarefusion_native_video_size(unsigned *width, unsigned *height)
+{
+   unsigned full = bitmap.viewport.w + 2 * bitmap.viewport.x;
+#ifdef KEGAREFUSION_32X
+   if (kegarefusion_32x_attached) full = 320 + 2 * bitmap.viewport.x;
+#endif
+   const unsigned crop = config.ntsc ? vwoffset * 2 / 5 : vwoffset;
+   if (!width || !height || full <= crop || !vheight) return false;
+   *width = full - crop; *height = vheight;
+   return true;
+}
+RETRO_API void retro_kegarefusion_debug_capabilities(uint32_t *video, uint64_t *audio)
+{
+   uint32_t v = ((system_hw & SYSTEM_PBC) == SYSTEM_MD) ? 15u : 24u;
+   uint64_t a = 15u;
+   if ((system_hw & SYSTEM_PBC) == SYSTEM_MD) a |= (UINT64_C(63) << 4) | (UINT64_C(1) << 36);
+   else if ((system_hw == SYSTEM_MARKIII || system_hw == SYSTEM_SMS || system_hw == SYSTEM_SMS2 || system_hw == SYSTEM_PBC) && (config.ym2413 & 1)) a |= UINT64_C(16383) << 10;
+   if (system_hw == SYSTEM_MCD) a |= UINT64_C(1023) << 24;
+#ifdef KEGAREFUSION_32X
+   if (kegarefusion_32x_attached) { v |= 32u; a |= UINT64_C(3) << 34; }
+#endif
+   if (video) *video = v;
+   if (audio) *audio = a;
+}
+
 RETRO_API unsigned retro_kegarefusion_system_hw(void)
 {
    return system_hw;
