+/* Kega Refusion datagram transport for the MIT GGPO core. */
+#ifndef KEGA_GGPO_TRANSPORT_H
+#define KEGA_GGPO_TRANSPORT_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct KegaGgpoTransport {
+    void *user;
+    void (*send)(void *user, uint32_t address_host_order, uint16_t port_host_order,
+                 const void *data, int length);
+    /* Return 0 when empty, a positive datagram length, or a negative error. */
+    int (*receive)(void *user, uint32_t *address_host_order,
+                   uint16_t *port_host_order, void *data, int capacity);
+} KegaGgpoTransport;
+
+/* Copy hooks for this thread. Each subsequently created session copies them.
+ * Passing NULL clears the hooks and restores GGPO native UDP. Both callbacks
+ * are required when a transport is supplied. Keep user alive through session close. */
+void kega_ggpo_set_transport(const KegaGgpoTransport *transport);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
