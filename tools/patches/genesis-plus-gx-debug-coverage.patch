+unsigned kr_cov_sms_bios_size(void)
+{
+  if (!(system_bios & (SYSTEM_SMS | SYSTEM_GG))) return 0;
+  return bios_rom.pages << (bios_rom.mapper == MAPPER_SEGA ? 14 : 10);
