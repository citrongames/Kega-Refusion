+kr_cov_access kr_cov_sms_data(uint32_t address)
+{
+  const uint8_t *base = z80_readmap[address >> 10];
+  const bool mapped = z80_readmem == read_mapper_default ||
+      (z80_readmem == read_mapper_none && address >= 0xc000) ||
+      (z80_readmem == read_mapper_93c46 && (address != 0x8000 || !eeprom_93c.enabled)) ||
+      (z80_readmem == read_mapper_terebi && address != 0x8000 && address != 0xa000) ||
+      z80_readmem == read_mapper_korea_8k;
+  return (kr_cov_access){mapped && base ? base + (address & 0x3ff) : NULL, 1};
