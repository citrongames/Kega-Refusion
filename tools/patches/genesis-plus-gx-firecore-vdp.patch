 /*--------------------------------------------------------------------------*/
 
+/* Rebuild derived mode and palette state without rearranging the shared VRAM. */
+static void vdp_firecore_palette_refresh(void)
+{
+  int i;
+  color_update_firecore(0, *(uint16 *)&kr_firecore_cram[border << 2]);
+  color_update_firecore(1, *(uint16 *)&kr_firecore_cram[(border << 2) + 2]);
+  for (i = 2; i < 0x400; i++)
+    color_update_firecore(i, *(uint16 *)&kr_firecore_cram[i << 1]);
+}
+
+void vdp_firecore_refresh_rendering(void)
+{
+  if (!KR_FIRECORE_VDP_ENABLED)
+    return;
+  update_bg_pattern_cache = update_bg_pattern_cache_firecore;
+  parse_satb = im2_flag ? parse_satb_m5_im2 : parse_satb_m5;
+  if (reg[0x18] & 0x40)
+    render_bg = render_bg_firecore_bitmap;
+  else if (im2_flag)
+    render_bg = (reg[11] & 4) ? render_bg_firecore_im2_vs : render_bg_firecore_im2;
+  else
+    render_bg = (reg[11] & 4) ? render_bg_firecore_vs : render_bg_firecore;
+  if (im2_flag)
+    render_obj = (reg[12] & 8) ? render_obj_firecore_im2_ste : render_obj_firecore_im2;
+  else
+    render_obj = (reg[12] & 8) ? render_obj_firecore_ste : render_obj_firecore;
+}
+
+static void vdp_update_md_rendering_mode(unsigned int cycles)
+{
+  int i;
+  if (KR_FIRECORE_VDP_ENABLED || (reg[1] & 4))
+  {
+    update_bg_pattern_cache = update_bg_pattern_cache_m5;
+    parse_satb = im2_flag ? parse_satb_m5_im2 : parse_satb_m5;
+    if (im2_flag)
+    {
+      render_bg = (reg[11] & 4) ? render_bg_m5_im2_vs : render_bg_m5_im2;
+      render_obj = (reg[12] & 8) ? render_obj_m5_im2_ste : render_obj_m5_im2;
+    }
+    else
+    {
+      render_bg = (reg[11] & 4) ? (config.enhanced_vscroll ? render_bg_m5_vs_enhanced : render_bg_m5_vs) : render_bg_m5;
+      render_obj = (reg[12] & 8) ? render_obj_m5_ste : render_obj_m5;
+    }
+    if (KR_FIRECORE_VDP_ENABLED)
+    {
+      vdp_firecore_refresh_rendering();
+      vdp_firecore_palette_refresh();
+    }
+    else
+    {
+      color_update_m5(0, *(uint16 *)&cram[border << 1]);
+      for (i = 1; i < 0x40; i++)
+        color_update_m5(i, *(uint16 *)&cram[i << 1]);
+    }
+    vdp_68k_data_w = vdp_68k_data_w_m5;
+    vdp_z80_data_w = vdp_z80_data_w_m5;
+    vdp_68k_data_r = vdp_68k_data_r_m5;
+    vdp_z80_data_r = vdp_z80_data_r_m5;
+    hvc_latch = (reg[0] & 2) ? (vdp_hvc_r(cycles) | 0x10000) : 0;
+    bg_list_index = 0x800;
+  }
+  else
+  {
+    parse_satb = parse_satb_m4;
+    update_bg_pattern_cache = update_bg_pattern_cache_m4;
+    render_bg = render_bg_m4;
+    render_obj = render_obj_m4;
+    for (i = 0; i < 0x20; i++)
+      color_update_m4(i, *(uint16 *)&cram[i << 1]);
+    color_update_m4(0x40, *(uint16 *)&cram[(0x10 | (border & 15)) << 1]);
+    vdp_68k_data_w = vdp_68k_data_w_m4;
+    vdp_z80_data_w = vdp_z80_data_w_m4;
+    vdp_68k_data_r = vdp_68k_data_r_m4;
+    vdp_z80_data_r = vdp_z80_data_r_m4;
+    hvc_latch = vdp_hvc_r(cycles) | 0x10000;
+    bg_list_index = 0x200;
+  }
+  for (i = 0; i < bg_list_index; i++)
+  {
+    bg_name_list[i] = i;
+    bg_name_dirty[i] = 0xff;
+  }
+  vc_max = vc_table[((reg[1] >> 2) | (KR_FIRECORE_VDP_ENABLED ? 1 : 0)) & 3][vdp_pal];
+  bitmap.viewport.changed |= 2;
+}
