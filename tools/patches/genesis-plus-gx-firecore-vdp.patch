+/* Extended table registers latch physical 6bpp offsets at the time of a write. */
+static unsigned int vdp_firecore_table(unsigned int address)
+{
+  if (!KR_FIRECORE_VDP_ENABLED)
+    return address & 0xffff;
+  return (address + ((address >= 0xc000) ? 0x6000 : 0)) & 0x1ffff;
+}
