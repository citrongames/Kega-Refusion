+/* Extended SSF exposes 256 x 512 KiB banks. The legacy state uses byte-sized
+ * 64 KiB page indices, so retain its layout and put wide indices in the
+ * existing, mutually exclusive cartridge trailer for newly supported ROMs. */
+int md_cart_large_ssf_active(void)
+{
+  return system_hw == SYSTEM_MD && cart.romsize > 0x2000000 &&
+         (cart.hw.time_w == mapper_512k_w || cart.hw.time_w == mapper_32x_ssf_w);
+}
+
+int md_cart_large_ssf_state_valid(const uint8 *state)
+{
+  unsigned i;
+  if (memcmp(state, "KRSSF001", 8)) return 0;
+  for (i = 0; i < 0x40; ++i)
+  {
+    unsigned page = (state[8 + i*2] << 8) | state[9 + i*2];
+    if (page != 0xffff && page != 0xfffe && page > (cart.mask >> 16)) return 0;
+  }
+  return 1;
+}
+
+int md_cart_large_ssf_state_save(uint8 *state)
+{
+  unsigned i;
+  memset(state, 0, MD_CART_COMPAT_STATE_SIZE);
+  memcpy(state, "KRSSF001", 8);
+  for (i = 0; i < 0x40; ++i)
+  {
+    uint8 *base = m68k.memory_map[i].base;
+    unsigned page;
+    if (base == sram.sram) page = 0xffff;
+    else if (base == boot_rom) page = 0xfffe;
+    else
+    {
+      uintptr_t offset = (uintptr_t)base - (uintptr_t)cart.rom;
+      if (offset > cart.mask || (offset & 0xffff)) return 0;
+      page = (unsigned)(offset >> 16);
+    }
+    state[8 + i*2] = page >> 8;
+    state[9 + i*2] = page & 0xff;
+  }
+  return 1;
+}
+
+void md_cart_large_ssf_state_load(const uint8 *state)
+{
+  unsigned i;
+  for (i = 0; i < 0x40; ++i)
+  {
+    unsigned page = (state[8 + i*2] << 8) | state[9 + i*2];
+    if (page == 0xffff)
+    {
+      m68k.memory_map[i].base = sram.sram;
+      m68k.memory_map[i].read8 = sram_read_byte;
+      m68k.memory_map[i].read16 = sram_read_word;
+      m68k.memory_map[i].write8 = sram_write_byte;
+      m68k.memory_map[i].write16 = sram_write_word;
+      zbank_memory_map[i].read = sram_read_byte;
+      zbank_memory_map[i].write = sram_write_byte;
+    }
+    else
+    {
+      if (m68k.memory_map[i].base == sram.sram)
+      {
+        m68k.memory_map[i].read8 = NULL;
+        m68k.memory_map[i].read16 = NULL;
+        m68k.memory_map[i].write8 = m68k_unused_8_w;
+        m68k.memory_map[i].write16 = m68k_unused_16_w;
+        zbank_memory_map[i].read = NULL;
+        zbank_memory_map[i].write = zbank_unused_w;
+      }
+      m68k.memory_map[i].base = page == 0xfffe ? boot_rom : cart.rom + (page << 16);
+    }
+  }
+}
+
+/* Sega SSF on 32X keeps the first bank fixed. F1 controls SRAM; F3..FF
+ * select seven 512 KiB pages (full 8-bit values for modern large carts).
+ * Unlike the Mega EverDrive extended MD mapper, F1 is not ROM bank zero. */
+static void mapper_32x_ssf_w(uint32 address, uint32 data)
+{
+  if ((address & 0xfffff0) != 0xa130f0) return;
+  if (address & 0x0e) mapper_512k_w(address, data);
+  else mapper_sega_w(data);
+}
