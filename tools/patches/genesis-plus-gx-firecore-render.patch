+
+/* Convert packed 2x2 YUV blocks using the same integer coefficients as the
+ * pinned reference. This avoids its 128K-entry color LUT and needs no cache. */
+static PIXEL_OUT_T firecore_bitmap_pixel(uint32 value)
+{
+  int c = (int)((value & 31) << 3) - 16;
+  int d = (int)(((value >> 11) & 63) << 2) - 128;
+  int e = (int)(((value >> 5) & 63) << 2) - 128;
+  int r = (298*c + 409*e + 128) >> 8;
+  int g = (298*c - 100*d - 208*e + 128) >> 8;
+  int b = (298*c + 516*d + 128) >> 8;
+  r = r < 0 ? 0 : (r > 255 ? 255 : r);
+  g = g < 0 ? 0 : (g > 255 ? 255 : g);
+  b = b < 0 ? 0 : (b > 255 ? 255 : b);
+  return firecore_rgb(r, g, b);
+}
+
+static void firecore_remap_line(int line)
+{
+  int x;
+  int width = bitmap.viewport.w + 2*bitmap.viewport.x;
+  const uint32 *src = &linebuf_firecore[0][0x20 - bitmap.viewport.x];
+  PIXEL_OUT_T *dst;
+  PIXEL_OUT_T *capture = NULL;
+  line = (line + bitmap.viewport.y) % lines_per_frame;
+  if (line < 0) return;
+  if (interlaced && config.render) line = (line * 2) + odd_frame;
+  if (line >= bitmap.height || width <= 0 || width > bitmap.width) return;
+  dst = (PIXEL_OUT_T *)&bitmap.data[line * bitmap.pitch];
+  if (kega_recording_bitmap) capture = (PIXEL_OUT_T *)(kega_recording_bitmap + line * bitmap.pitch);
+  for (x = 0; x < width; ++x)
+  {
+    uint32 value = src[x];
+    PIXEL_OUT_T color = value < 0x800 ? firecore_render->palette[value & 0x1ff] : firecore_bitmap_pixel(value - 0x800);
+    if (kega_debug_video_mask && value < 0x800 && !(value & 0x3f))
+      color = firecore_rgb((kega_debug_backdrop >> 16) & 255, (kega_debug_backdrop >> 8) & 255, kega_debug_backdrop & 255);
+    if (capture) capture[x] = color;
+    if (config.lcd && !kegarefusion_rewind_preview_active)
+    {
+      int r = GET_R(color), g = GET_G(color), b = GET_B(color);
+      int dr = GET_R(dst[x]) - r, dg = GET_G(dst[x]) - g, db = GET_B(dst[x]) - b;
+      if (dr > 0) r += (config.lcd * dr) >> 8;
+      if (dg > 0) g += (config.lcd * dg) >> 8;
+      if (db > 0) b += (config.lcd * db) >> 8;
+      color = PIXEL(r,g,b);
+    }
+    dst[x] = color;
+    if (kega_sprite_hint_active && width <= 720)
+      kega_sprite_hint_bitmap[line * 720 + x] = kega_sprite_hint_line[0x20 - bitmap.viewport.x + x] & 1;
+  }
+}
+
+static void firecore_render_line(int line)
+{
+  if (kega_sprite_hint_active) memset(kega_sprite_hint_line, 0, sizeof(kega_sprite_hint_line));
+  if (reg[1] & 0x40)
+  {
+    if (bg_list_index)
+    {
+      update_bg_pattern_cache_firecore(bg_list_index);
+      bg_list_index = 0;
+    }
+    render_bg(line);
+    if (kega_debug_video_mask & 8u)
+    {
+      uint32 background[0x200];
+      memcpy(background, linebuf_firecore[0], sizeof(background));
+      render_obj(line & 1);
+      memcpy(linebuf_firecore[0], background, sizeof(background));
+    }
+    else render_obj(line & 1);
+    if (reg[0] & 0x20)
+    {
+      memset(&linebuf_firecore[0][0x20], 0, 8 * sizeof(uint32));
+      if (kega_sprite_hint_active) memset(&kega_sprite_hint_line[0x20], 0, 8);
+    }
+    if (line < bitmap.viewport.h - 1) parse_satb(line);
+    if (bitmap.viewport.x > 0)
+    {
+      memset(&linebuf_firecore[0][0x20 - bitmap.viewport.x], 0, bitmap.viewport.x * sizeof(uint32));
+      memset(&linebuf_firecore[0][0x20 + bitmap.viewport.w], 0, bitmap.viewport.x * sizeof(uint32));
+    }
+  }
+  else memset(&linebuf_firecore[0][0x20 - bitmap.viewport.x], 0, (bitmap.viewport.w + 2*bitmap.viewport.x) * sizeof(uint32));
+  firecore_remap_line(line);
+}
