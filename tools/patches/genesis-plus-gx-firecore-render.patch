+/* AtGames Firecore renderer, derived from karmic64's Cyclone implementation
+ * (306cfb020cdb). Keep the shared MD cache and sprite parser. Only Firecore
+ * sessions allocate these buffers; priority is evaluated directly rather than
+ * retaining the reference's three 8 MiB mixing tables. */
+#include <stdlib.h>
+
+typedef struct
+{
+  uint32 line[2][0x200];
+  uint32 rgb[0x200];
+  PIXEL_OUT_T palette[0x200];
+} firecore_render_t;
+
+static firecore_render_t *firecore_render;
+#define linebuf_firecore (firecore_render->line)
+#define FIRECORE_RENDERING (kr_firecore_active && (reg[0x18] & 0x80) && firecore_render)
+
+static const uint16 atex_table_firecore[8] =
+{ 0x000, 0x040, 0x080, 0x0c0, 0x200, 0x240, 0x280, 0x2c0 };
+
+static PIXEL_OUT_T firecore_rgb(unsigned r, unsigned g, unsigned b)
+{
+#if defined(USE_32BPP_RENDERING)
+  return PIXEL(r, g, b);
+#elif defined(USE_16BPP_RENDERING)
+  return PIXEL(r >> 3, g >> 2, b >> 3);
+#elif defined(USE_15BPP_RENDERING)
+  return PIXEL(r >> 3, g >> 3, b >> 3);
+#else
+  return PIXEL(r >> 5, g >> 5, b >> 6);
+#endif
+}
+
+void color_update_firecore(int index, unsigned int data)
+{
+  unsigned i = (index >> 1) & 0x1ff;
+  uint32 rgb;
+  if (!firecore_render) return;
+  rgb = firecore_render->rgb[i];
+  if (index & 1) rgb = (rgb & 0xffff00) | (data & 0xff);
+  else rgb = (rgb & 0xff) | ((data & 0xff) << 16) | (data & 0xff00);
+  firecore_render->rgb[i] = rgb;
+  firecore_render->palette[i] = firecore_rgb(rgb >> 16, (rgb >> 8) & 255, rgb & 255);
+}
+
+int render_firecore_init(void)
+{
+  if (!firecore_render) firecore_render = (firecore_render_t *)calloc(1, sizeof(*firecore_render));
+  return firecore_render != NULL;
+}
+
+void render_firecore_shutdown(void)
+{
+  free(firecore_render);
+  firecore_render = NULL;
+}
+
+void render_firecore_reset(void)
+{
+  if (firecore_render) memset(firecore_render, 0, sizeof(*firecore_render));
+}
+
+static uint32 firecore_read32(unsigned address)
+{
+  uint32 value;
+  address &= 0x1ffff;
+  if (address <= 0x1fffc) memcpy(&value, &vram[address], sizeof(value));
+  else
+  {
+    uint8 bytes[4];
+    unsigned i;
+    for (i = 0; i < 4; ++i) bytes[i] = vram[(address + i) & 0x1ffff];
+    memcpy(&value, bytes, sizeof(value));
+  }
+  return value;
+}
+
+static void firecore_draw_column(uint32 *dst, uint32 attr, unsigned row, unsigned palette)
+{
+  unsigned tile, x;
+  for (tile = 0; tile < 2; ++tile)
+  {
+#ifdef LSB_FIRST
+    unsigned a = (attr >> (tile * 16)) & 0xffff;
+#else
+    unsigned a = (attr >> ((1 - tile) * 16)) & 0xffff;
+#endif
+    const uint8 *src = &bg_pattern_cache[((a & 0x1fff) << 6) | row];
+    unsigned bits = atex_table_firecore[(a >> 13) & 7] | palette;
+    for (x = 0; x < 8; ++x) *dst++ = *src++ | bits;
+  }
+}
+
+#define DRAW_COLUMN_FIRECORE(ATTR, ROW, PAL) do { \
+  firecore_draw_column(dst, ATTR, ROW, PAL); dst += 16; \
+} while (0);
+
+static void firecore_merge_background(uint32 *a, uint32 *b, uint32 *dst, unsigned width, int line)
+{
+  unsigned x;
+  int left = 0, right = bitmap.viewport.w;
+  if (((reg[18] >> 7) & 1) != (line >= ((reg[18] & 0x1f) << 3)))
+  {
+    left = clip[1].enable ? clip[1].left << 4 : 0;
+    right = clip[1].enable ? clip[1].right << 4 : 0;
+  }
+  for (x = 0; x < width; ++x)
+  {
+    unsigned ax = a[x], bx = b[x], c;
+    if (kega_debug_video_mask & (1u << (((int)x >= left && (int)x < right) ? 2 : 0))) ax = 0;
+    if (kega_debug_video_mask & 2u) bx = 0;
+    c = (ax & 0x200) ? ((ax & 0x3f) ? ax : bx) :
+        ((bx & 0x200) ? ((bx & 0x3f) ? bx : ax) : ((ax & 0x3f) ? ax : bx));
+    dst[x] = (c & 0x3f) ? (c & 0x3ff) : 0;
+  }
+}
+
+void render_bg_firecore(int line)
+{
+  int column;
+  uint32 atbuf, *dst;
+
+  /* Common data */
+  uint32 xscroll      = firecore_read32(hscb + ((line & hscroll_mask) << 2));
+  uint32 yscroll      = *(uint32 *)&vsram[0];
+  uint32 pf_col_mask  = playfield_col_mask;
+  uint32 pf_row_mask  = playfield_row_mask;
+  uint32 pf_shift     = playfield_shift;
+
+  /* Window & Plane A */
+  int a = (reg[18] & 0x1F) << 3;
+  int w = (reg[18] >> 7) & 1;
+
+  /* Plane B width */
+  int start = 0;
+  int end = bitmap.viewport.w >> 4;
+
+  /* Plane B scroll */
+#ifdef LSB_FIRST
+  uint32 shift  = (xscroll >> 16) & 0x0F;
+  uint32 index  = pf_col_mask + 1 - ((xscroll >> 20) & pf_col_mask);
+  uint32 v_line = (line + (yscroll >> 16)) & pf_row_mask;
+#else
+  uint32 shift  = (xscroll & 0x0F);
+  uint32 index  = pf_col_mask + 1 - ((xscroll >> 4) & pf_col_mask);
+  uint32 v_line = (line + yscroll) & pf_row_mask;
+#endif
+
+  /* Plane B name table */
+  uint32 nt = ntbb + (((v_line >> 3) << pf_shift) & 0x1FC0);
+
+  /* Pattern row index */
+  v_line = (v_line & 7) << 3;
+
+  if(shift)
+  {
+    /* Plane B line buffer */
+    dst = (uint32 *)&linebuf_firecore[0][0x10 + shift];
+
+    atbuf = firecore_read32(nt + (((index - 1) & pf_col_mask) << 2));
+    DRAW_COLUMN_FIRECORE(atbuf, v_line, bpalbase)
+  }
+  else
+  {
+    /* Plane B line buffer */
+    dst = (uint32 *)&linebuf_firecore[0][0x20];
+  }
+
+  for(column = 0; column < end; column++, index++)
+  {
+    atbuf = firecore_read32(nt + ((index & pf_col_mask) << 2));
+    DRAW_COLUMN_FIRECORE(atbuf, v_line, bpalbase)
+  }
+
+  if (w == (line >= a))
+  {
+    /* Window takes up entire line */
+    a = 0;
+    w = 1;
+  }
+  else
+  {
+    /* Window and Plane A share the line */
+    a = clip[0].enable;
+    w = clip[1].enable;
+  }
+
+  /* Plane A */
+  if (a)
+  {
+    /* Plane A width */
+    start = clip[0].left;
+    end   = clip[0].right;
+
+    /* Plane A scroll */
+#ifdef LSB_FIRST
+    shift   = (xscroll & 0x0F);
+    index   = pf_col_mask + start + 1 - ((xscroll >> 4) & pf_col_mask);
+    v_line  = (line + yscroll) & pf_row_mask;
+#else
+    shift   = (xscroll >> 16) & 0x0F;
+    index   = pf_col_mask + start + 1 - ((xscroll >> 20) & pf_col_mask);
+    v_line  = (line + (yscroll >> 16)) & pf_row_mask;
+#endif
+
+    /* Plane A name table */
+    nt = ntab + (((v_line >> 3) << pf_shift) & 0x1FC0);
+
+    /* Pattern row index */
+    v_line = (v_line & 7) << 3;
+
+    if(shift)
+    {
+      /* Plane A line buffer */
+      dst = (uint32 *)&linebuf_firecore[1][0x10 + shift + (start << 4)];
+
+      /* Window bug */
+      if (start)
+      {
+        atbuf = firecore_read32(nt + ((index & pf_col_mask) << 2));
+      }
+      else
+      {
+        atbuf = firecore_read32(nt + (((index - 1) & pf_col_mask) << 2));
+      }
+
+      DRAW_COLUMN_FIRECORE(atbuf, v_line, apalbase)
+    }
+    else
+    {
+      /* Plane A line buffer */
+      dst = (uint32 *)&linebuf_firecore[1][0x20 + (start << 4)];
+    }
+
+    for(column = start; column < end; column++, index++)
+    {
+      atbuf = firecore_read32(nt + ((index & pf_col_mask) << 2));
+      DRAW_COLUMN_FIRECORE(atbuf, v_line, apalbase)
+    }
+
+    /* Window width */
+    start = clip[1].left;
+    end   = clip[1].right;
+  }
+
+  /* Window */
+  if (w)
+  {
+    /* Window name table */
+    nt = ntwb | ((line >> 3) << (6 + (reg[12] & 1)));
+
+    /* Pattern row index */
+    v_line = (line & 7) << 3;
+
+    /* Plane A line buffer */
+    dst = (uint32 *)&linebuf_firecore[1][0x20 + (start << 4)];
+
+    for(column = start; column < end; column++)
+    {
+      atbuf = firecore_read32(nt + ((column) << 2));
+      DRAW_COLUMN_FIRECORE(atbuf, v_line, wpalbase)
+    }
+  }
+
+  /* Merge background layers */
+  firecore_merge_background(&linebuf_firecore[1][0x20], &linebuf_firecore[0][0x20], &linebuf_firecore[0][0x20], bitmap.viewport.w, line);
+}
+
+
+
+void render_bg_firecore_vs(int line)
+{
+  int column;
+  uint32 atbuf, *dst;
+  uint32 v_line, nt;
+
+  /* Common data */
+  uint32 xscroll      = firecore_read32(hscb + ((line & hscroll_mask) << 2));
+  uint32 yscroll      = 0;
+  uint32 pf_col_mask  = playfield_col_mask;
+  uint32 pf_row_mask  = playfield_row_mask;
+  uint32 pf_shift     = playfield_shift;
+  uint32 *vs          = (uint32 *)&vsram[0];
+
+  /* Window & Plane A */
+  int a = (reg[18] & 0x1F) << 3;
+  int w = (reg[18] >> 7) & 1;
+
+  /* Plane B width */
+  int start = 0;
+  int end = bitmap.viewport.w >> 4;
+
+  /* Plane B horizontal scroll */
+#ifdef LSB_FIRST
+  uint32 shift  = (xscroll >> 16) & 0x0F;
+  uint32 index  = pf_col_mask + 1 - ((xscroll >> 20) & pf_col_mask);
+#else
+  uint32 shift  = (xscroll & 0x0F);
+  uint32 index  = pf_col_mask + 1 - ((xscroll >> 4) & pf_col_mask);
+#endif
+
+  /* Left-most column vertical scrolling when partially shown horizontally (verified on PAL MD2)  */
+  /* TODO: check on Genesis 3 models since it apparently behaves differently  */
+  /* In H32 mode, vertical scrolling is disabled, in H40 mode, same value is used for both planes */
+  /* See Formula One / Kawasaki Superbike Challenge (H32) & Gynoug / Cutie Suzuki no Ringside Angel (H40) */
+  if (reg[12] & 1)
+  {
+    yscroll = vs[19] & (vs[19] >> 16);
+  }
+
+  if(shift)
+  {
+    /* Plane B vertical scroll */
+    v_line = (line + yscroll) & pf_row_mask;
+
+    /* Plane B name table */
+    nt = ntbb + (((v_line >> 3) << pf_shift) & 0x1FC0);
+
+    /* Pattern row index */
+    v_line = (v_line & 7) << 3;
+
+    /* Plane B line buffer */
+    dst = (uint32 *)&linebuf_firecore[0][0x10 + shift];
+
+    atbuf = firecore_read32(nt + (((index - 1) & pf_col_mask) << 2));
+    DRAW_COLUMN_FIRECORE(atbuf, v_line, bpalbase)
+  }
+  else
+  {
+    /* Plane B line buffer */
+    dst = (uint32 *)&linebuf_firecore[0][0x20];
+  }
+
+  for(column = 0; column < end; column++, index++)
+  {
+    /* Plane B vertical scroll */
+#ifdef LSB_FIRST
+    v_line = (line + (vs[column] >> 16)) & pf_row_mask;
+#else
+    v_line = (line + vs[column]) & pf_row_mask;
+#endif
+
+    /* Plane B name table */
+    nt = ntbb + (((v_line >> 3) << pf_shift) & 0x1FC0);
+
+    /* Pattern row index */
+    v_line = (v_line & 7) << 3;
+
+    atbuf = firecore_read32(nt + ((index & pf_col_mask) << 2));
+    DRAW_COLUMN_FIRECORE(atbuf, v_line, bpalbase)
+  }
+
+  if (w == (line >= a))
+  {
+    /* Window takes up entire line */
+    a = 0;
+    w = 1;
+  }
+  else
+  {
+    /* Window and Plane A share the line */
+    a = clip[0].enable;
+    w = clip[1].enable;
+  }
+
+  /* Plane A */
+  if (a)
+  {
+    /* Plane A width */
+    start = clip[0].left;
+    end   = clip[0].right;
+
+    /* Plane A horizontal scroll */
+#ifdef LSB_FIRST
+    shift = (xscroll & 0x0F);
+    index = pf_col_mask + start + 1 - ((xscroll >> 4) & pf_col_mask);
+#else
+    shift = (xscroll >> 16) & 0x0F;
+    index = pf_col_mask + start + 1 - ((xscroll >> 20) & pf_col_mask);
+#endif
+
+    if(shift)
+    {
+      /* Plane A vertical scroll */
+      v_line = (line + yscroll) & pf_row_mask;
+
+      /* Plane A name table */
+      nt = ntab + (((v_line >> 3) << pf_shift) & 0x1FC0);
+
+      /* Pattern row index */
+      v_line = (v_line & 7) << 3;
+
+      /* Plane A line buffer */
+      dst = (uint32 *)&linebuf_firecore[1][0x10 + shift + (start << 4)];
+
+      /* Window bug */
+      if (start)
+      {
+        atbuf = firecore_read32(nt + ((index & pf_col_mask) << 2));
+      }
+      else
+      {
+        atbuf = firecore_read32(nt + (((index - 1) & pf_col_mask) << 2));
+      }
+
+      DRAW_COLUMN_FIRECORE(atbuf, v_line, apalbase)
+    }
+    else
+    {
+      /* Plane A line buffer */
+      dst = (uint32 *)&linebuf_firecore[1][0x20 + (start << 4)];
+    }
+
+    for(column = start; column < end; column++, index++)
+    {
+      /* Plane A vertical scroll */
+#ifdef LSB_FIRST
+      v_line = (line + vs[column]) & pf_row_mask;
+#else
+      v_line = (line + (vs[column] >> 16)) & pf_row_mask;
+#endif
+
+      /* Plane A name table */
+      nt = ntab + (((v_line >> 3) << pf_shift) & 0x1FC0);
+
+      /* Pattern row index */
+      v_line = (v_line & 7) << 3;
+
+      atbuf = firecore_read32(nt + ((index & pf_col_mask) << 2));
+      DRAW_COLUMN_FIRECORE(atbuf, v_line, apalbase)
+    }
+
+    /* Window width */
+    start = clip[1].left;
+    end   = clip[1].right;
+  }
+
+  /* Window */
+  if (w)
+  {
+    /* Window name table */
+    nt = ntwb | ((line >> 3) << (6 + (reg[12] & 1)));
+
+    /* Pattern row index */
+    v_line = (line & 7) << 3;
+
+    /* Plane A line buffer */
+    dst = (uint32 *)&linebuf_firecore[1][0x20 + (start << 4)];
+
+    for(column = start; column < end; column++)
+    {
+      atbuf = firecore_read32(nt + ((column) << 2));
+      DRAW_COLUMN_FIRECORE(atbuf, v_line, wpalbase)
+    }
+  }
+
+  /* Merge background layers */
+  firecore_merge_background(&linebuf_firecore[1][0x20], &linebuf_firecore[0][0x20], &linebuf_firecore[0][0x20], bitmap.viewport.w, line);
+}
+
