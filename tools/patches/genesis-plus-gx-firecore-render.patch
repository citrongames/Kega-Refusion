+/*** firecore bitmap bg ***/
+void render_bg_firecore_bitmap(int line)
+{
+  int width = bitmap.viewport.w;
+  
+  uint32 *dst = &linebuf_firecore[0][0x20];
+  
+  uint8 *src = &vram[0x4e00 + 320*(line & (~1))];
+  int row = line & 1;
+  if (kega_debug_video_mask & 1u)
+  {
+    memset(dst, 0, width * sizeof(*dst));
+    return;
+  }
+  
+  for (int column = 0; column < width; column += 2)
+  {
+#ifdef LSB_FIRST
+    uint32 box = ((uint32)src[3]<<24) | ((uint32)src[2]<<16) | ((uint32)src[1]<<8) | src[0];
+#else
+    uint32 box = ((uint32)src[2]<<24) | ((uint32)src[3]<<16) | ((uint32)src[0]<<8) | src[1];
+#endif
+    
+    uint8 y = box >> 26;
+    uint8 u = (box >> 20) & 0x3f;
+    uint8 vl;
+    uint8 vr;
+    if (!row)
+    { /*** upper ***/
+      vl = box & 0x1f;
+      vr = (box >> 5) & 0x1f;
+    }
+    else
+    { /*** lower ***/
+      vl = (box >> 10) & 0x1f;
+      vr = (box >> 15) & 0x1f;
+    }
+    
+    *(dst++) = ((y<<11)|(u<<5)|vl) + 0x800;
+    *(dst++) = ((y<<11)|(u<<5)|vr) + 0x800;
+    
+    src += 4;
+  }
+}
+
