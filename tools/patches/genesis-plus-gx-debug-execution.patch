diff --git a/core/cart_hw/sms_cart.c b/core/cart_hw/sms_cart.c
--- a/core/cart_hw/sms_cart.c
+++ b/core/cart_hw/sms_cart.c
@@ -3034,10 +3034,8 @@
   return z80_readmap[address >> 10][address & 0x03FF];
 }
 
-static unsigned char read_mapper_korea_8k(unsigned int address)
-{
-  unsigned char data = z80_readmap[address >> 10][address & 0x03FF];
-
+static unsigned char mapper_korea_8k_data(unsigned int address, unsigned char data)
+{
   /* 16KB page */
   unsigned char page = address >> 14;
 
@@ -3054,6 +3052,11 @@
   return data;
 }
 
+static unsigned char read_mapper_korea_8k(unsigned int address)
+{
+  return mapper_korea_8k_data(address, z80_readmap[address >> 10][address & 0x03ff]);
+}
+
 static unsigned char read_mapper_default(unsigned int address)
 {
   return z80_readmap[address >> 10][address & 0x03FF];
@@ -3085,3 +3088,27 @@
     kr_inspect_put(info, part, "Z80 cartridge", name, 2, slot.fcr[i]);
   }
 }
+
+#include "../kegadebug/hooks.h"
+
+int kr_debug_peek_sms(uint32_t address, uint8_t *byte)
+{
+  const uint8_t *base = z80_readmap[address >> 10];
+  if (!base)
+    return 0;
+
+  /* Known mapper handlers select the current read page. The EEPROM,
+   * drawing tablet and open-bus slots need their own peek semantics. */
+  const int mapped = z80_readmem == read_mapper_default ||
+      (z80_readmem == read_mapper_none && address >= 0xc000) ||
+      (z80_readmem == read_mapper_93c46 && (address != 0x8000 || !eeprom_93c.enabled)) ||
+      (z80_readmem == read_mapper_terebi && address != 0x8000 && address != 0xa000) ||
+      z80_readmem == read_mapper_korea_8k;
+  if (!mapped)
+    return 0;
+
+  *byte = base[address & 0x3ff];
+  if (z80_readmem == read_mapper_korea_8k)
+    *byte = mapper_korea_8k_data(address, *byte);
+  return 1;
+}
