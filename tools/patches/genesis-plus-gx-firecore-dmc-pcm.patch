+int kr_firecore_dmc_pcm;
+
+/* The 2009 DMC PCM driver copies four bytes per DAC sample, then busy-waits
+ * for the rest of each buffer. Distribute the same work over all samples.
+ * Only replace an intact upload before its first instruction, in sound RAM.
+ * ROM reads and checksums continue to see the original program. */
+static void firecore_prepare_pcm_driver(void)
+{
+  static const uint8 delay[] = {
+    0x3e, 0x09,       /* LD A,9 */
+    0x3d, 0x20, 0xfd, /* DEC A / JR NZ,-3 */
+    0xd9, 0xc9        /* EXX / RET, as in the original exit */
+  };
+  static const uint8 idle_delay[] = {0x13,0x1b,0x13,0x1b,0x13,0x1b};
+
+  if (memcmp(zram + 9, "DMC Z80 Driver Demo", 19) ||
+      crc32(0, zram, 1073) != 0x49963811u)
+    return;
+
+  zram[0x216] = 1; /* refill one byte */
+  zram[0x22a] = 1; /* subtract one from remaining length */
+  zram[0x235] = 0x2a;
+  zram[0x236] = 0; /* JP NZ,$002A into unused space before the IM 1 vector */
+  memcpy(zram + 0x2a, delay, sizeof(delay));
+  /* Replace NOPs in the idle branch with balanced INC DE / DEC DE pairs.
+   * These preserve registers and flags while matching the refill cadence. */
+  memcpy(zram + 0x24f, idle_delay, 2);
+  memcpy(zram + 0x25c, idle_delay, sizeof(idle_delay));
+}
