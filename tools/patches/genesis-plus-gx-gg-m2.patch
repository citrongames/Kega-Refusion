+/* Bound the sparse view to 16 KiB. New profiles must fit this limit or
+ * selection fails without changing the ordinary Sega cart. */
+#define M2_MAX_OVERLAY_PAGES 16
+static const m2_profile_t *m2_active_profile;
+static uint16 m2_page_numbers[M2_MAX_OVERLAY_PAGES];
+static uint8 m2_page_data[M2_MAX_OVERLAY_PAGES][0x400];
+static unsigned int m2_page_count;
+
+static int m2_build_view(const m2_profile_t *profile)
+{
+  unsigned int i, page, previous = 0;
+  m2_page_count = 0;
+  for (i = 0; i < profile->delta_count; ++i)
+  {
+    const m2_delta_t *delta = &profile->deltas[i];
+    if ((delta->offset >= profile->size) ||
+        (i && (delta->offset <= previous)) ||
+        (cart.rom[delta->offset] != delta->source))
+      return 0;
+
+    previous = delta->offset;
+    page = delta->offset >> 10;
+    if (!m2_page_count || (m2_page_numbers[m2_page_count - 1] != page))
+    {
+      if (m2_page_count == M2_MAX_OVERLAY_PAGES)
+        return 0;
+      m2_page_numbers[m2_page_count] = page;
+      memcpy(m2_page_data[m2_page_count],
+             cart.rom + (page << 10), 0x400);
+      ++m2_page_count;
+    }
+    m2_page_data[m2_page_count - 1][delta->offset & 0x3ff] = delta->value;
+  }
+  return m2_page_count != 0;
+}
+
+/* Resolve a 1 KiB ROM page while building the CPU read map, never per read.
+ * This also serves the cartridge mirrored into BIOS space when no BIOS is
+ * installed. A real BIOS has its own mapper and does not see this view. */
+static uint8 *m2_rom_page(unsigned int offset)
+{
+  unsigned int i;
+  if ((slot.mapper == MAPPER_M2_COLLECTION) && m2_active_profile)
+  {
+    for (i = 0; i < m2_page_count; ++i)
+    {
+      if (m2_page_numbers[i] == (offset >> 10))
+        return m2_page_data[i];
+    }
+  }
+  return &slot.rom[offset];
+}
