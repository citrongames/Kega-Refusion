+/* The horizontal blank fetches sprite patterns from VRAM. A slot with
+ * no new pattern repeats its latched address. Plane B exposes slots 4/5
+ * on the right and 36/37 on the left. */
+int render_sprite_bus_step(int physical_line)
+{
+  if ((reg[1] & 0x44) != 0x44 || !(reg[12] & 1) || im2_flag || kr_firecore_active)
+    return 0;
+
+  static const uint8 bus_slot[PLANE_B_BUS_ROWS] = {4, 5, 36, 37};
+  const object_info_t *objects = obj_info[physical_line & 1];
+  const int count = object_count[physical_line & 1];
+  int n, first = 0, slot = 0;
+  for (n = 0; n < count && slot < PLANE_B_BUS_ROWS; ++n)
+  {
+    const object_info_t *object = &objects[n];
+    const int end = first + 1 + (object->size >> 2);
+    if (bus_slot[slot] < end)
+    {
+      const unsigned int attr = object->attr;
+      const unsigned int y = object->ypos;
+      const uint8 *offsets = &name_lut[((attr >> 3) & 0x300) |
+        (object->size << 4) | ((y & 0x18) >> 1)];
+      const unsigned int row = (y ^ ((attr & 0x1000) ? 7 : 0)) & 7;
+      do
+      {
+        const unsigned int tile = ((attr & 0x7ff) + offsets[bus_slot[slot] - first]) & 0x7ff;
+        sprite_bus_rows[slot++] = (tile << 5) + (row << 2);
+      }
+      while (slot < PLANE_B_BUS_ROWS && bus_slot[slot] < end);
+    }
+    first = end;
+  }
+  return 1;
+}
