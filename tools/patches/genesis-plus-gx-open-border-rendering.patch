+static unsigned int horizontal_border_pixel(uint16 address, unsigned int pixel)
+{
+  /* The external VRAM bus has not passed through horizontal tile flipping. */
+  unsigned int byte = READ_BYTE(vram, address + (pixel >> 1));
+  return ((pixel & 1) ? byte : byte >> 4) & 15;
+}
