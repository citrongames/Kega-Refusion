+/* Test-port Plane B uses the normal extra prefetch for fine scrolling.
+ * During the rest of each horizontal border, its colour index comes from
+ * the sprite fetch bus and the last two Plane B palette bits. */
+static void render_test_plane_b_border(int raster)
+{
+  const unsigned int hscroll = *(uint16 *)&vram[hscb + ((raster & hscroll_mask) << 2) + 2];
+  const unsigned int yscroll = *(uint16 *)&vsram[2];
+  const unsigned int index = playfield_col_mask + 1 - ((hscroll >> 4) & playfield_col_mask);
+  const int fine = hscroll & 0xf;
+  const int left = 16 - fine;
+  const unsigned int v = (raster + yscroll) & playfield_row_mask;
+  const unsigned int row = (v & 7) << 3;
+  const uint16 *nt = (const uint16 *)&vram[ntbb + (((v >> 3) << playfield_shift) & 0x1fc0)];
+  const unsigned int last_pair = (index + (bitmap.viewport.w >> 4) - 1) & playfield_col_mask;
+  const unsigned int first_pair = (index - 1) & playfield_col_mask;
+  int i;
+  for (i = 0; i < bitmap.viewport.x; ++i)
+  {
+    int x = i - bitmap.viewport.x;
+    int lp = x + left;
+    int rp = i + left;
+    unsigned int attr, data;
+    if (lp >= 0)
+    {
+      attr = nt[first_pair * 2 + (lp >> 3)];
+      data = bg_pattern_cache[((attr & 0x1fff) << 6) | row | (lp & 7)];
+    }
+    else
+    {
+      lp += 16;
+      attr = nt[last_pair * 2 + (lp >> 3)];
+      data = horizontal_border_pixel(sprite_bus_rows[2 + (lp >> 3)], lp & 7);
+    }
+    test_plane_line[0x20 + x] = (attr >> 9 & 0x30) | data;
+
+    if (rp < 16)
+    {
+      attr = nt[last_pair * 2 + (rp >> 3)];
+      data = bg_pattern_cache[((attr & 0x1fff) << 6) | row | (rp & 7)];
+    }
+    else
+    {
+      rp -= 16;
+      attr = nt[last_pair * 2 + (rp >> 3)];
+      data = horizontal_border_pixel(sprite_bus_rows[rp >> 3], rp & 7);
+    }
+    test_plane_line[0x20 + bitmap.viewport.w + i] = (attr >> 9 & 0x30) | data;
+  }
+}
