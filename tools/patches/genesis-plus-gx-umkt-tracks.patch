+/* UMKT revisions change individual songs and loader addresses. Identify the
+ * 68000 upload and the actual Z80 DAC program it loads, in canonical ROM order. */
+int md_cart_umkt_tracks_active;
+
+static int umkt_rom_matches(unsigned offset, const uint8 *pattern, unsigned length)
+{
+  unsigned i;
+  if (offset > cart.romsize || length > cart.romsize - offset) return 0;
+  for (i = 0; i < length; i++)
+    if (READ_BYTE(cart.rom, offset + i) != pattern[i]) return 0;
+  return 1;
+}
+
+static unsigned umkt_rom_pointer(unsigned at)
+{
+  return (unsigned)READ_BYTE(cart.rom, at) << 24 |
+         (unsigned)READ_BYTE(cart.rom, at + 1) << 16 |
+         (unsigned)READ_BYTE(cart.rom, at + 2) << 8 | READ_BYTE(cart.rom, at + 3);
+}
+
+/* The older player selects between two copies of the stock sound driver.
+ * Its sample descriptors can point beyond the 10 MiB linear cartridge area. */
+static int umkt_extended_samples(void)
+{
+  static const uint8 jsr[] = {0x4e,0xb9};
+  static const uint8 selector[] = {0x30,0x39,0x00,0xff,0xf8,0x6e,0x0c,0x40,0xcc,0xcc};
+  static const uint8 second[] = {0x4e,0x75,0x41,0xf9};
+  static const uint8 driver[] = {0xf3,0xed,0x56,0x31,0x20,0x1b};
+  const unsigned table = 0x3c9830;
+  unsigned target, at;
+  if (!umkt_rom_matches(0x3d7666, jsr, sizeof(jsr))) return 0;
+  target = umkt_rom_pointer(0x3d7668);
+  if (target > cart.romsize - 32 ||
+      !umkt_rom_matches(target, selector, sizeof(selector)) ||
+      !umkt_rom_matches(target + 22, second, sizeof(second))) return 0;
+  if (!umkt_rom_matches(umkt_rom_pointer(target + 26), driver, sizeof(driver))) return 0;
+  /* Twelve-byte descriptors store a little-endian 24-bit offset from the table.
+   * A padded linear ROM can contain this selector too. Require a backed sample
+   * in one of the packed windows before installing the extra banks. */
+  for (at = table; at < table + 96 * 12; at += 12)
+  {
+    unsigned address, offset, length;
+    if (READ_BYTE(cart.rom, at) != 8) continue;
+    address = (table + (READ_BYTE(cart.rom, at + 1) |
+               (unsigned)READ_BYTE(cart.rom, at + 2) << 8 |
+               (unsigned)READ_BYTE(cart.rom, at + 3) << 16)) & 0xffffff;
+    if (address >= 0xa80000 && address < 0xc00000) offset = address - 0x80000;
+    else if (address >= 0xc80000 && address < 0xe00000) offset = address - 0x100000;
+    else continue;
+    length = READ_BYTE(cart.rom, at + 6) | (unsigned)READ_BYTE(cart.rom, at + 7) << 8;
+    if (length && offset < cart.romsize && length <= cart.romsize - offset) return 1;
+  }
+  return 0;
+}
+
+static int md_cart_umkt_tracks_detect(void)
+{
+  static const uint8 product[] = "GM T-097146-00";
+  /* Request the sound bus, release reset, then LEA the driver source into A0. */
+  static const uint8 load[] = {0x33,0xfc,0x01,0x00,0x00,0xa1,0x11,0x00,
+                               0x33,0xfc,0x01,0x00,0x00,0xa1,0x12,0x00,0x41,0xf9};
+  /* Copy 256 bytes from (A0)+ to ZRAM. */
+  static const uint8 copy[] = {0x22,0x7c,0x00,0xa0,0x00,0x00,0x30,0x3c,
+                               0x01,0x00,0x12,0xd8,0x53,0x40,0x66,0xfa};
+  /* Z80 program sets its stack and pans channel 6, then enables the YM2612 DAC. */
+  static const uint8 pcm[] = {0xf3,0x31,0xff,0x1f,0x3e,0xb4,0x32,0x02,0x40,
+                              0x3e,0xc0,0x32,0x03,0x40,0x3e,0x2b,0x32,0x00,
+                              0x40,0x3e,0x80,0x32,0x01,0x40};
+  unsigned at, src;
+  if (cart.romsize <= 0xa00000 || !umkt_rom_matches(0x180, product, sizeof(product)-1))
+    return 0;
+  if (umkt_extended_samples()) return MD_CART_UMKT_PACKED_ONLY;
+  for (at = 0x7f0000; at < 0x7f1800; at += 2)
+  {
+    if (!umkt_rom_matches(at, load, sizeof(load)) ||
+        !umkt_rom_matches(at + sizeof(load) + 4, copy, sizeof(copy))) continue;
+    src = umkt_rom_pointer(at + sizeof(load));
+    if (src <= cart.romsize - 256 && umkt_rom_matches(src, pcm, sizeof(pcm)))
+      return MD_CART_UMKT_UPLOAD;
+  }
+  return 0;
+}
+
+/* Gens 13 MiB format packs samples around the two 512 KiB I/O windows:
+ * A8-BF -> file A0-B7, C8-DF -> file B8-CF. Keep A0-A7 and C0-C7 hardware. */
+void md_cart_umkt_tracks_map(void)
+{
+  unsigned bank, offset;
+  if (!md_cart_umkt_tracks_active) return;
+  for (bank = 0xa8; bank < 0xe0; bank++)
+  {
+    if (bank >= 0xc0 && bank < 0xc8) continue;
+    offset = (bank - (bank < 0xc0 ? 8 : 16)) << 16;
+    if (offset >= cart.romsize) break;
+    m68k.memory_map[bank].base = cart.rom + offset;
+    m68k.memory_map[bank].read8 = NULL;
+    m68k.memory_map[bank].read16 = NULL;
+    m68k.memory_map[bank].write8 = m68k_unused_8_w;
+    m68k.memory_map[bank].write16 = m68k_unused_16_w;
+    zbank_memory_map[bank].read = NULL;
+    zbank_memory_map[bank].write = zbank_unused_w;
+  }
+}
+
