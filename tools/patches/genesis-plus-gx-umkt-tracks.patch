+/* The H20/H22/H23 +TRACKS sound drivers expect Gens' packed 13 MiB
+ * cartridge map, beyond the normal cartridge area. This is an emulator-specific
+ * format, not general Mega Drive hardware. Identify executable code rather
+ * than a mutable filename/header checksum. */
+int md_cart_umkt_tracks_active;
+static int md_cart_umkt_tracks_detect(void)
+{
+  static const char product[] = "GM T-097146-00";
+  uint8 block[256];
+  uint32 crc = 0;
+  unsigned offset, i;
+  if (cart.romsize != 0xd00000) return 0;
+  for (i = 0; i < sizeof(product) - 1; i++)
+    if (READ_BYTE(cart.rom, 0x180 + i) != (uint8)product[i]) return 0;
+  for (offset = 0x7f0000; offset < 0x7f1800; offset += sizeof(block))
+  {
+    for (i = 0; i < sizeof(block); i++) block[i] = READ_BYTE(cart.rom, offset + i);
+    crc = crc32(crc, block, sizeof(block));
+  }
+  return (crc == 0xfbd30d03) || (crc == 0x5a6206ae); /* H23 / H20-H22 */
+}
+
+/* Gens 13 MiB format packs samples around the two 512 KiB I/O windows:
+ * A8-BF -> file A0-B7, C8-DF -> file B8-CF. Keep A0-A7 and C0-C7 hardware. */
+void md_cart_umkt_tracks_map(void)
+{
+  unsigned bank;
+  if (!md_cart_umkt_tracks_active) return;
+  for (bank = 0xa8; bank < 0xe0; bank++)
+  {
+    if (bank >= 0xc0 && bank < 0xc8) continue;
+    m68k.memory_map[bank].base = cart.rom + ((bank - (bank < 0xc0 ? 8 : 16)) << 16);
+    m68k.memory_map[bank].read8 = NULL;
+    m68k.memory_map[bank].read16 = NULL;
+    m68k.memory_map[bank].write8 = m68k_unused_8_w;
+    m68k.memory_map[bank].write16 = m68k_unused_16_w;
+    zbank_memory_map[bank].read = NULL;
+    zbank_memory_map[bank].write = zbank_unused_w;
+  }
+}
+
 void md_cart_init(void)
 {
   int i;
+
+  md_cart_umkt_tracks_active = md_cart_umkt_tracks_detect();
 
   /***************************************************************************************************************
                 CARTRIDGE ROM MIRRORING                                                                                   
@@ -1404,12 +1447,14 @@
     /* initialize PCM and CD-DA audio */
     audio_set_rate(snd.sample_rate, snd.frame_rate);
