+/* IrataHack board: four 128 KiB games on one SST39SF040.
+ * The original image remains intact for identification and cold starts.
+ * A recognized cartridge has 512 KiB or less; the emulator's existing
+ * cartridge workspace above it can hold the writable chip and an ID page. */
+#define IRATA_FLASH (cart.rom + 0x100000)
+#define IRATA_ID_PAGE (IRATA_FLASH + SMS_IRATA_FLASH_SIZE)
+enum { IRATA_READ, IRATA_UNLOCK1, IRATA_UNLOCK2, IRATA_PROGRAM,
+       IRATA_ERASE1, IRATA_ERASE2, IRATA_ERASE_CONFIRM, IRATA_ID };
+
+static int irata_seeded;
+
+void sms_cart_new_content(void)
+{
+  irata_seeded = 0;
+}
+
+uint8 *sms_cart_irata_flash(void)
+{
+  return irata_seeded && system_hw && ((system_hw & SYSTEM_PBC) != SYSTEM_MD) &&
+         cart_rom.mapper == MAPPER_IRATA ? IRATA_FLASH : NULL;
+}
+
+static unsigned int irata_offset(unsigned int address)
+{
+  unsigned int base = (slot.fcr[1] & 3) << 17;
+  if (address < 0x8000)
+    return base + address;
+  return base + ((slot.fcr[2] & 7) << 14) + (address & 0x3fff);
+}
+
+static void irata_map(void)
+{
+  int i;
+  for (i = 0; i < 0x30; ++i)
+    z80_readmap[i] = IRATA_FLASH + irata_offset(i << 10);
+
+  if (slot.fcr[0] == IRATA_ID)
+  {
+    z80_readmap[0] = IRATA_ID_PAGE;
+    for (i = 1; i < 0x10; ++i)
+      z80_readmap[i] = cart.rom + 0x510400;
+  }
+}
+
+static void write_mapper_irata(unsigned int address, unsigned char data)
+{
+  unsigned int offset, command_address;
+  uint8 *phase = &slot.fcr[0];
+  if (address >= 0xc000)
+  {
+    write_mapper_none(address, data);
+    if (address >= 0xfffe)
+    {
+      unsigned int reg = (address == 0xfffe) ? 1 : 2;
+      data &= (reg == 1) ? 3 : 7;
+      if (slot.fcr[reg] != data)
+      {
+        slot.fcr[reg] = data;
+        irata_map();
+      }
+    }
+    return;
+  }
+
+  offset = irata_offset(address);
+  command_address = offset & 0x7fff;
+  switch (*phase)
+  {
+    case IRATA_READ:
+      if (command_address == 0x5555 && data == 0xaa)
+        *phase = IRATA_UNLOCK1;
+      break;
+    case IRATA_UNLOCK1:
+      *phase = (command_address == 0x2aaa && data == 0x55) ? IRATA_UNLOCK2 : IRATA_READ;
+      break;
+    case IRATA_UNLOCK2:
+      *phase = IRATA_READ;
+      if (command_address == 0x5555)
+      {
+        if (data == 0xa0) *phase = IRATA_PROGRAM;
+        else if (data == 0x80) *phase = IRATA_ERASE1;
+        else if (data == 0x90)
+        {
+          *phase = IRATA_ID;
+          irata_map();
+        }
+      }
+      break;
+    case IRATA_PROGRAM:
+      IRATA_FLASH[offset] &= data;
+      *phase = IRATA_READ;
+      break;
+    case IRATA_ERASE1:
+      *phase = (command_address == 0x5555 && data == 0xaa) ? IRATA_ERASE2 : IRATA_READ;
+      break;
+    case IRATA_ERASE2:
+      *phase = (command_address == 0x2aaa && data == 0x55) ? IRATA_ERASE_CONFIRM : IRATA_READ;
+      break;
+    case IRATA_ERASE_CONFIRM:
+      if (data == 0x30)
+        memset(IRATA_FLASH + (offset & ~0xfffu), 0xff, 0x1000);
+      else if (command_address == 0x5555 && data == 0x10)
+        memset(IRATA_FLASH, 0xff, SMS_IRATA_FLASH_SIZE);
+      *phase = IRATA_READ;
+      break;
+    case IRATA_ID:
+      if (data == 0xf0)
+      {
+        *phase = IRATA_READ;
+        irata_map();
+      }
+      break;
+    default:
+      *phase = IRATA_READ;
+      break;
+  }
+}
