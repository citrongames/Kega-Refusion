+/* RedKid slides the first 4 MiB cartridge window by a physical ROM offset.
+ * The 68000, Z80 bank window, and VDP DMA share the same CPU page bases. */
+static uint32 firecore_offset;
+static uint32 firecore_chip_mask;
+static uint16 firecore_gpio;
+
+/* Two 8 MiB flash chips share the window on RedKid boards. The ROM dump
+ * concatenates them; each chip begins with its own executable image. */
+static int firecore_has_second_chip(void)
+{
+  unsigned i;
+  static const char board[] = "DMC RedKid";
+  if (cart.romsize != 0x1000000) return 0;
+  for (i = 0; i < sizeof(board) - 1; ++i)
+    if (READ_BYTE(cart.rom, 0x100 + i) != board[i]) return 0;
+  return ((READ_BYTE(cart.rom, 0x800100) == 'S') &&
+          (READ_BYTE(cart.rom, 0x800101) == 'E') &&
+          (READ_BYTE(cart.rom, 0x800102) == 'G') &&
+          (READ_BYTE(cart.rom, 0x800103) == 'A')) ||
+         ((READ_BYTE(cart.rom, 0x800100) == 'D') &&
+          (READ_BYTE(cart.rom, 0x800101) == 'M') &&
+          (READ_BYTE(cart.rom, 0x800102) == 'C') &&
+          (READ_BYTE(cart.rom, 0x800103) == ' '));
+}
+
+static void firecore_map(uint32 offset)
+{
+  unsigned page, copied = 0;
+  const uint32 span = firecore_chip_mask + 1;
+  uint8 *chip = cart.rom + ((firecore_gpio & 0x20) ? 0 : (cart.mask ^ firecore_chip_mask));
+  firecore_offset = offset & firecore_chip_mask & ~1u;
+  for (page = 0; page < 0x40; ++page)
+  {
+    uint32 start;
+    uint8 *base;
+    if (m68k.memory_map[page].read16) continue; /* Preserve RAM and device overlays. */
+    start = (firecore_offset + (page << 16)) & firecore_chip_mask;
+    base = chip + start;
+    if (span - start < 0x10000)
+    {
+      /* At most one distinct page straddles the physical ROM boundary.
+       * Smaller ROMs may mirror it at several logical addresses. */
+      if (!copied)
+      {
+        const unsigned tail = span - start;
+        memcpy(cart.firecore_wrap, chip + start, tail);
+        memcpy(cart.firecore_wrap + tail, chip, 0x10000 - tail);
+        copied = 1;
+      }
+      base = cart.firecore_wrap;
+    }
+    if (!page) cart.base = base;
+    if (m68k.memory_map[page].base != boot_rom)
+      m68k.memory_map[page].base = base;
+  }
+}
+
+int md_cart_firecore_dual_flash(void)
+{
+  return kr_firecore_active && firecore_chip_mask != cart.mask;
+}
+
+unsigned int md_cart_firecore_gpio_read(void)
+{
+  return firecore_gpio;
+}
+
+void md_cart_firecore_gpio_write(unsigned int value)
+{
+  const uint16 changed = firecore_gpio ^ value;
+  firecore_gpio = value;
+  if (changed & 0x20) firecore_map(firecore_offset);
+}
+
+static unsigned int firecore_io_read(unsigned int address)
+{
+  (void)address;
+  return 0;
+}
+
+static void firecore_bank_write(unsigned int address, unsigned int data)
+{
+  uint32 offset;
+  switch (address & 0xffffff)
+  {
+    case 0xb01028: offset = (firecore_offset & 0xffff0000u) | (data & 0xfffe); break;
+    case 0xb0102a: offset = ((uint32)data << 16) | (firecore_offset & 0xffff); break;
+    default: return;
+  }
+  offset &= firecore_chip_mask;
+  if (offset != firecore_offset) firecore_map(offset);
+}
+
+void md_cart_firecore_rom_changed(void)
+{
+  if (kr_firecore_active && (firecore_offset & 0xffff))
+    firecore_map(firecore_offset);
+}
+
+void md_cart_firecore_state_save(uint8 *out)
+{
+  memset(out, 0, MD_CART_COMPAT_STATE_SIZE);
+  if (firecore_offset || firecore_gpio != 0x20)
+  {
+    memcpy(out, "KRFCBNK1", 8);
+    link_wire_put32(out + 8, firecore_offset);
+    link_wire_put32(out + 12, firecore_gpio);
+  }
+}
+
+void md_cart_firecore_state_load(const uint8 *in)
+{
+  /* Pre-banking Firecore snapshots use the original ROM window. */
+  if (!memcmp(in, "KRFCBNK1", 8))
+  {
+    firecore_gpio = link_wire_get32(in + 12);
+    firecore_map(link_wire_get32(in + 8));
+  }
+  else
+  {
+    firecore_gpio = 0x20;
+    firecore_map(0);
+  }
+}
