+/* Configure the complete adapter topology atomically. Pad slots are logical,
+ * ordered across port A then port B; inactive slots keep their physical position.
+ * No protocol/state is reset unless the frontend changes the topology. */
+RETRO_API bool retro_kegarefusion_multitap(unsigned mode, unsigned connected, unsigned six)
+{
+   unsigned count, i;
+   int master = (mode >= 5 && mode <= 7);
+   int md = ((system_hw & SYSTEM_PBC) == SYSTEM_MD);
+   int sms = (system_hw == SYSTEM_SMS || system_hw == SYSTEM_SMS2 ||
+              system_hw == SYSTEM_MARKIII || system_hw == SYSTEM_PBC);
+   if (mode < 1 || mode > 7 || (master ? !sms : !md)) return false;
+   if (mode == 4) { input.system[0] = input.system[1] = SYSTEM_WAYPLAY; count = 4; }
+   else
+   {
+      unsigned placement = master ? mode - 4 : mode;
+      input.system[0] = placement == 2 ? SYSTEM_GAMEPAD : (master ? SYSTEM_MASTERTAP : SYSTEM_TEAMPLAYER);
+      input.system[1] = placement == 1 ? SYSTEM_GAMEPAD : (master ? SYSTEM_MASTERTAP : SYSTEM_TEAMPLAYER);
+      count = placement == 3 ? 8 : 5;
+   }
+   for (i = 0; i < MAX_INPUTS; ++i)
+      config.input[i].padtype = i >= count || !(connected & (1u << i)) ? NO_DEVICE :
+         master ? DEVICE_PAD2B : (six & (1u << i)) ? DEVICE_PAD6B : DEVICE_PAD3B;
+   old_system[0] = input.system[0]; old_system[1] = input.system[1];
+   io_init(); input_reset();
+   return true;
+}
