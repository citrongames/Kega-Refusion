+static int yx5200_packet_valid(void)
+{
+  unsigned int sum = 0;
+  int i;
+  if (yx5200.rxBuffer[0] != 0x7e || yx5200.rxBuffer[1] != 0xff ||
+      yx5200.rxBuffer[2] != 0x06 || yx5200.rxBuffer[9] != 0xef)
+    return 0;
+  for (i = 1; i <= 6; i++) sum += yx5200.rxBuffer[i];
+  sum += (yx5200.rxBuffer[7] << 8) | yx5200.rxBuffer[8];
+  return (sum & 0xffff) == 0;
+}
+
+static void yx5200_packet_resync(void)
+{
+  unsigned int i;
+  /* Keep any suffix that can still be the start of a complete packet. */
+  for (i = 1; i < yx5200.rxCounter; i++)
+  {
+    unsigned int count = yx5200.rxCounter - i;
+    if (yx5200.rxBuffer[i] == 0x7e &&
+        (count < 2 || yx5200.rxBuffer[i+1] == 0xff) &&
+        (count < 3 || yx5200.rxBuffer[i+2] == 0x06))
+    {
+      memmove(yx5200.rxBuffer, yx5200.rxBuffer + i, count);
+      yx5200.rxCounter = count;
+      return;
+    }
+  }
+  yx5200.rxCounter = 0;
+}
