+/* Mode 4 status path when the frontend skips pixels. Reuse sprite decoding,
+ * without drawing the background or converting a framebuffer scanline. */
+void render_sms_sprite_line(int line)
+{
+  status |= spr_ovr;
+  spr_ovr = 0;
+  /* A latched collision stays set until a status read. One sprite cannot
+   * collide with itself; neither case needs decoded pixels on a hidden row. */
+  if (!(reg[1] & 0x40) || object_count[line & 1] < 2 || (status & 0x20))
+    return;
+  if (bg_list_index)
+  {
+    update_bg_pattern_cache(bg_list_index);
+    bg_list_index = 0;
+  }
+  memset(&linebuf[0][0x20], 0, 256);
+  render_obj(line & 1);
+}
