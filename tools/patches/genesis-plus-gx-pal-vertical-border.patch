+/* V28/V30 moves the VBlank comparator independently of the output
+ * viewport. When a write moves it behind the beam, VBlank is skipped and
+ * HINT keeps counting through the bottom border. Walk physical scanlines
+ * until the next output frame boundary, even if the two boundaries differ. */
+static void system_frame_variable(int do_skip, int cd)
+{
+  int line = vdp_frame_line ? vdp_frame_line : bitmap.viewport.h;
+  int active_end = bitmap.viewport.h;
+  int start = lines_per_frame - bitmap.viewport.y;
+  int end = active_end + bitmap.viewport.y;
+  int first = 1, wrapped = 0;
+  const int reset_line = v_counter == line;
+
+  vdp_variable_raster = 1;
+  status &= 0xFEED;
+  if (interlaced)
+  {
+    odd_frame ^= 1;
+    status |= odd_frame << 4;
+  }
+
+  do
+  {
+    const int last = line == lines_per_frame - 1;
+    const int height = vdp_live_height();
+    int blank, active, vblank_start;
+
+    if (line == 0)
+    {
+      /* A write during the preceding border can change the next viewport. */
+      vdp_forgotten_border = 0;
+      active_end = height;
+      if (bitmap.viewport.h != active_end)
+      {
+        bitmap.viewport.h = active_end;
+        bitmap.viewport.y = (config.overscan & 1) *
+          (height == 192 ? 24 * (vdp_pal + 1) :
+           height == 224 ? 8 + 24 * vdp_pal : 24 * vdp_pal);
+        bitmap.viewport.oh = active_end;
+        bitmap.viewport.changed |= 1;
+        start = lines_per_frame - bitmap.viewport.y;
+        end = active_end + bitmap.viewport.y;
+      }
+    }
+
+    v_counter = line;
+    vblank_start = !(status & 8) && line == height;
+    /* A forgotten border still blanks the video memory bus at the V30
+     * boundary. HINT and border rendering continue independently. */
+    if (vblank_start || (line == 240 && vdp_forgotten_border))
+      status |= 8;
+    blank = (status & 8) != 0;
+    active = !blank || vdp_forgotten_border;
+    vdp_vint_armed = line == height && !(first && reset_line);
+
+    if (last)
+    {
+      if (!active) h_counter = reg[10];
+      status &= ~8;
+    }
+#ifdef KEGAREFUSION_32X
+    if (kegarefusion_32x_attached)
+    {
+      if (first) kegarefusion_32x_frame_start(do_skip);
+      kegarefusion_32x_line(line, mcycles_vdp);
+    }
+#endif
+
+    if ((!blank || last || vblank_start || first ||
+         (line == 240 && vdp_forgotten_border)) && dma_length)
+      vdp_dma_update(mcycles_vdp);
+
+    if (line < end || line >= start)
+    {
+      if (!active)
+        blank_line(line, -bitmap.viewport.x, bitmap.viewport.w + 2 * bitmap.viewport.x);
+      else if (!do_skip)
+        render_line(line);
+    }
+    else if (active && !last && !do_skip && (reg[1] & 0x40))
+    {
+      /* Only overscan rows reach the framebuffer, but sprite evaluation
+       * continues through the open border. */
+      parse_satb(line);
+    }
+    if (last && (reg[1] & 0x40)) parse_satb(-1);
+
+    input_refresh();
+    if (active || vblank_start)
+    {
+      if (h_counter == 0)
+      {
+        if (active) h_counter = reg[10];
+        hint_pending = 0x10;
+        if (reg[0] & 0x10) m68k_update_irq(4);
+      }
+      else if (active)
+        --h_counter;
+    }
+    if (first) osd_input_update();
+
+    if (vdp_vint_armed)
+    {
+      unsigned int vint_at = mcycles_vdp + vint_cycle;
+#ifdef KEGAREFUSION_32X
+      if (kegarefusion_32x_attached)
+        kegarefusion_32x_run(vint_at);
+      else
+#endif
+        m68k_run(vint_at);
+      if (zstate == 1) z80_run(vint_at);
+      status |= 0x80;
+      vint_pending = 0x20;
+      if (reg[1] & 0x20) m68k_set_irq(6);
+      Z80.irq_state = ASSERT_LINE;
+    }
+
+    unsigned int line_end = mcycles_vdp + MCYCLES_PER_LINE;
+#ifdef KEGAREFUSION_32X
+    if (kegarefusion_32x_attached)
+      kegarefusion_32x_run(line_end);
+    else
+#endif
+    if (cd)
+      scd_update(line_end);
+    else
+      m68k_run(line_end);
+    if (zstate == 1) z80_run(line_end);
+    if (vdp_vint_armed || first) Z80.irq_state = CLEAR_LINE;
+    if (!cd && svp) ssp1601_run(SVP_cycles);
+    render_sprite_phase2();
+
+    mcycles_vdp = line_end;
+    first = 0;
+    if (++line == lines_per_frame)
+    {
+      line = 0;
+      wrapped = 1;
+    }
+  }
+  while (!wrapped || line != active_end);
+
+  vdp_frame_line = line;
+  vdp_vint_armed = 0;
+  vdp_variable_raster = 0;
+}
+
+static int vdp_variable_frame_required(void)
+{
+  if (!vdp_pal || kr_firecore_active || bitmap.viewport.h == 192) return 0;
+
+  /* The fixed path is valid for V28/Mode 4 at their usual boundary. V30
+   * must watch the live comparator because a write can move it to V28
+   * before or after line 224 has passed. */
+  return bitmap.viewport.h == 240 || vdp_forgotten_border ||
+    (vdp_frame_line && (vdp_frame_line != bitmap.viewport.h || (status & 8)));
+}
