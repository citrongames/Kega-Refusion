+/* Only unchanged original sound drivers use this register board. In particular,
+ * an emulator-specific seed edit is not compatible with the original hardware. */
+int md_cart_barver_compat_active;
+static int md_cart_barver_hardware(const uint8 *rom, size_t size, int native_order)
+{
+  static const uint8 startup[] = {0xf3,0xed,0x56,0x31,0x00,0x20,0xc3,0x46,0x00};
+  static const uint8 seed[] = {0x01,0x00,0x00,0x00};
+  uint8 block[1024];
+  uint32 crc = 0;
+  unsigned offset, i;
+  if (size != 0x200000) return 0;
+  for (i = 0; i < sizeof(startup); i++)
+    if ((native_order ? READ_BYTE(rom, 0x1e3b02 + i) : rom[0x1e3b02 + i]) != startup[i]) return 0;
+  for (i = 0; i < sizeof(seed); i++)
+    if ((native_order ? READ_BYTE(rom, 0x1e3b32 + i) : rom[0x1e3b32 + i]) != seed[i]) return 0;
+  /* Canonical 8KB driver fingerprint, evaluated only at cartridge preparation.
+   * Translated text/graphics and header corrections are outside this region. */
+  for (offset = 0x1e3b02; offset < 0x1e5b02; offset += sizeof(block))
+  {
+    for (i = 0; i < sizeof(block); i++)
+      block[i] = native_order ? READ_BYTE(rom, offset + i) : rom[offset + i];
+    crc = crc32(crc, block, sizeof(block));
+  }
+  return crc == 0x62e910ff;
+}
