+/* Aq Renkan Awa: a 64x16 Microwire save device on the odd byte at 400001.
+ * Reuse the existing 93C46 engine; board DI is bit3, CS/CLK remain bits2/1. */
+uint8 md_cart_aq93c_active;
+static cpu_memory_map aq93c_underlay;
+static t_zbank_memory_map aq93c_z_underlay;
+
+static uint32 aq93c_read8(uint32 address)
+{
+  if (address == 0x400001) return eeprom_93c_read() & 1;
+  if (aq93c_underlay.read8) return aq93c_underlay.read8(address);
+  return READ_BYTE(aq93c_underlay.base, address & 0xffff);
+}
+static uint32 aq93c_read16(uint32 address)
+{
+  uint32 value = aq93c_underlay.read16 ? aq93c_underlay.read16(address) :
+                 READ_WORD(aq93c_underlay.base, address & 0xffff);
+  return address == 0x400000 ? (value & 0xff00) | (eeprom_93c_read() & 1) : value;
+}
+static void aq93c_write8(uint32 address, uint32 data)
+{
+  if (address == 0x400001) eeprom_93c_write((data & 6) | ((data >> 3) & 1));
+  else if (aq93c_underlay.write8) aq93c_underlay.write8(address, data);
+  else { WRITE_BYTE(aq93c_underlay.base, address & 0xffff, data); }
+}
+static void aq93c_write16(uint32 address, uint32 data)
+{
+  if (address == 0x400000) eeprom_93c_write((data & 6) | ((data >> 3) & 1));
+  else if (aq93c_underlay.write16) aq93c_underlay.write16(address, data);
+  else { WRITE_WORD(aq93c_underlay.base, address & 0xffff, data); }
+}
+static uint32 aq93c_zread(uint32 address)
+{
+  if (address == 0x400001) return eeprom_93c_read() & 1;
+  if (aq93c_z_underlay.read) return aq93c_z_underlay.read(address);
+  return READ_BYTE(aq93c_underlay.base, address & 0xffff);
+}
+static void aq93c_zwrite(uint32 address, uint32 data)
+{
+  if (address == 0x400001) eeprom_93c_write((data & 6) | ((data >> 3) & 1));
+  else if (aq93c_z_underlay.write) aq93c_z_underlay.write(address, data);
+  else { WRITE_BYTE(aq93c_underlay.base, address & 0xffff, data); }
+}
+static void aq93c_time_write(uint32 address, uint32 data)
+{
+  /* This serial-save board does not decode Sega TIME bankswitch registers. */
+  (void)address; (void)data;
+}
+void md_cart_aq93c_map(void)
+{
+  int i;
+  if (!md_cart_aq93c_active) return;
+  /* Old states may contain the erroneous generic parallel SRAM map. */
+  for (i = 0; i < 0x40; i++) if (m68k.memory_map[i].base == sram.sram)
+  {
+    m68k.memory_map[i].base = cart.rom + ((i << 16) & cart.mask);
+    m68k.memory_map[i].read8 = NULL;
+    m68k.memory_map[i].read16 = NULL;
+    m68k.memory_map[i].write8 = m68k_unused_8_w;
+    m68k.memory_map[i].write16 = m68k_unused_16_w;
+    zbank_memory_map[i].read = NULL;
+    zbank_memory_map[i].write = zbank_unused_w;
+  }
+  /* Overlay only the actual EEPROM port, preserving CD BIOS and other reads. */
+  if (m68k.memory_map[0x40].read8 != aq93c_read8)
+  {
+    aq93c_underlay = m68k.memory_map[0x40];
+    aq93c_z_underlay = zbank_memory_map[0x40];
+    m68k.memory_map[0x40].read8 = aq93c_read8;
+    m68k.memory_map[0x40].read16 = aq93c_read16;
+    m68k.memory_map[0x40].write8 = aq93c_write8;
+    m68k.memory_map[0x40].write16 = aq93c_write16;
+    zbank_memory_map[0x40].read = aq93c_zread;
+    zbank_memory_map[0x40].write = aq93c_zwrite;
+  }
+  if (cart.hw.time_w != aq93c_time_write)
+  {
+    cart.hw.time_w = aq93c_time_write;
+  }
+}
+
+/* Optional packed trailer in existing native-state capacity. No struct padding,
+ * pointers or offsets in the ordinary MD/CD/32X payload are changed. */
+int md_cart_aq93c_state_valid(const uint8 *s)
+{
+  uint32 expected, actual;
+  if (memcmp(s, "KRAQ93C!", 8)) return 1; /* pre-device legacy state */
+  if (s[8] != 1 || s[9] || s[10] || s[11] != MD_AQ93C_STATE_SIZE) return 0;
+  expected = ((uint32)s[12]<<24) | ((uint32)s[13]<<16) | ((uint32)s[14]<<8) | s[15];
+  actual = crc32(0, s + 16, MD_AQ93C_STATE_SIZE - 16);
+  if (expected != actual || s[16]>1 || s[17]>1 || s[18]>1 || s[20]>1 ||
+      s[24]>READ_WORD || s[25]>1 || s[19]>16) return 0;
+  if ((s[24]==GET_OPCODE && s[19]>=8) ||
+      ((s[24]==READ_WORD || s[24]==WRITE_WORD) && s[19]>=16)) return 0;
+  return 1;
+}
+void md_cart_aq93c_state_save(uint8 *s)
+{
+  uint32 crc;
+  memset(s, 0, MD_AQ93C_STATE_SIZE);
+  memcpy(s, "KRAQ93C!", 8); s[8]=1; s[11]=MD_AQ93C_STATE_SIZE;
+  s[16]=eeprom_93c.cs; s[17]=eeprom_93c.clk; s[18]=eeprom_93c.data;
+  s[19]=eeprom_93c.cycles; s[20]=eeprom_93c.we; s[21]=eeprom_93c.opcode;
+  s[22]=eeprom_93c.buffer>>8; s[23]=eeprom_93c.buffer;
+  s[24]=eeprom_93c.state; s[25]=eeprom_93c.enabled;
+  memcpy(s+32,sram.sram,128);
+  crc=crc32(0,s+16,MD_AQ93C_STATE_SIZE-16);
+  s[12]=crc>>24;s[13]=crc>>16;s[14]=crc>>8;s[15]=crc;
+}
+void md_cart_aq93c_state_load(const uint8 *s)
+{
+  eeprom_93c_init(); /* legacy states retain existing battery bytes */
+  if (!memcmp(s,"KRAQ93C!",8))
+  {
+    eeprom_93c.cs=s[16];eeprom_93c.clk=s[17];eeprom_93c.data=s[18];
+    eeprom_93c.cycles=s[19];eeprom_93c.we=s[20];eeprom_93c.opcode=s[21];
+    eeprom_93c.buffer=(s[22]<<8)|s[23];eeprom_93c.state=(T_STATE_93C)s[24];
+    eeprom_93c.enabled=s[25];memcpy(sram.sram,s+32,128);
+  }
+  md_cart_aq93c_map();
+}
