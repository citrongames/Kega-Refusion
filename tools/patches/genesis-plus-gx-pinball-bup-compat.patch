+/* Mega Pinball Fantasies CD 1.09B passes odd buffers to the BIOS BUP API.
+ * Identify the exact boot programs, independently of container/name. Cache
+ * once per mount; ordinary discs are rejected using the existing header. */
+static int legacy_pinball = -1;
+int cdd_legacy_pinball(void)
+{
+  uint8 sector[2048];
+  unsigned long crc = 0;
+  int saved_lba, saved_index;
+  int64_t saved_position;
+  if (legacy_pinball >= 0) return legacy_pinball;
+  legacy_pinball = 0;
+  if (!cdd.loaded || !achievement_header_valid || kr_megald_active ||
+      !cdd.toc.tracks[0].type || cdd.toc.tracks[0].end < 60 ||
+      crc32(0, achievement_header, sizeof(achievement_header)) != 0x06b0d1efUL)
+    return 0;
+  saved_position = cdd.toc.tracks[0].fd ? cdStreamTell(cdd.toc.tracks[0].fd) : -1;
+  saved_lba = cdd.lba;
+  saved_index = cdd.index;
+  cdd.index = 0;
+  for (int i = 0; i < 60; ++i)
+  {
+    cdd.lba = i;
+    memset(sector, 0, sizeof(sector));
+    cdd_read_data(sector, NULL);
+    crc = crc32(crc, sector, sizeof(sector));
+  }
+  if (saved_position >= 0) cdStreamSeek(cdd.toc.tracks[0].fd, saved_position, SEEK_SET);
+  cdd.lba = saved_lba;
+  cdd.index = saved_index;
+  legacy_pinball = (crc == 0xc0c737fdUL);
+  return legacy_pinball;
+}
