+{
+   return io_reg;
+}
+
+RETRO_API void retro_kegarefusion_link_connect(uint8_t *peer,
+      void (*yield)(void *, unsigned), void *user)
+{
+   if (kegarefusion_32x_attached || system_hw != SYSTEM_MD) peer = NULL;
+   io_link_connect(peer, yield, user);
+}
+
+RETRO_API void retro_kegarefusion_link_deadline(unsigned cycles)
+{
+   io_link_deadline = cycles;
+}
+
+RETRO_API unsigned retro_kegarefusion_link_latch(void)
+{
+   return io_link_latch();
+}
+
+RETRO_API void retro_kegarefusion_link_restore_latch(unsigned latch)
+{
+   io_link_restore_latch(latch);
+}
