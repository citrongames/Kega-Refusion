+/* Port-B cable model derived from Linn1024/zero-tolerance-link (2026).
+ * Same Genesis Plus GX noncommercial/source-distribution license as this file.
+ * No ROM-specific behavior: the two emulated games implement the protocol. */
+void (*io_link_yield)(void *user, unsigned int cycles) = 0;
+unsigned int io_link_deadline = 0;
+unsigned int io_link_irq_pending = 0;
+unsigned int io_link_vdp_irq = 0;
+static uint8 *io_link_peer = 0;
+static void *io_link_user = 0;
+static unsigned int io_link_previous_th = 1;
+
+static unsigned int io_link_peer_th(void)
+{
+  /* An input pin is pulled high; peer TR is crossed to local TH. */
+  return ((io_link_peer[2] | ~io_link_peer[5]) >> 5) & 1;
+}
+
+void io_link_sync(unsigned int cycles)
+{
+  unsigned int th, falling;
+  if (!io_link_yield) return;
+  io_link_yield(io_link_user, cycles);
+  th = io_link_peer_th();
+  falling = io_link_previous_th && !th;
+  io_link_previous_th = th;
+  if (falling && (io_reg[5] & 0x80) && !(io_reg[5] & 0x40) && (reg[11] & 8))
+  {
+    m68k_update_irq(2);
+    /* An edge observed in an I/O handler must be taken at the next instruction
+     * boundary, even when the scheduler had selected a longer time slice. */
+    io_link_deadline = cycles;
+  }
+}
+
+void io_link_connect(uint8 *peer, void (*yield)(void *, unsigned int), void *user)
+{
+  if (io_link_yield)
+  {
+    io_link_irq_pending = 0;
+    m68k_set_irq(io_link_vdp_irq);
+  }
+  io_link_peer = (peer && yield && system_hw == SYSTEM_MD) ? peer : 0;
+  io_link_user = io_link_peer ? user : 0;
+  io_link_yield = io_link_peer ? yield : 0;
+  io_link_deadline = 0;
+  io_link_irq_pending = 0;
+  io_link_vdp_irq = io_link_peer && ((m68k.int_level >> 8) >= 4) ? (m68k.int_level >> 8) : 0;
+  /* Connecting or restoring never invents a falling edge. */
+  io_link_previous_th = io_link_peer ? io_link_peer_th() : 1;
+}
+
+unsigned int io_link_latch(void)
+{
+  return io_link_previous_th | (io_link_irq_pending << 1) | (io_link_vdp_irq << 8);
+}
+
+void io_link_restore_latch(unsigned int latch)
+{
+  unsigned int level = (latch >> 8) & 7;
+  io_link_previous_th = latch & 1;
+  io_link_irq_pending = (latch >> 1) & 1;
+  io_link_vdp_irq = (level == 4 || level == 6) ? level : 0;
+  if (io_link_yield) m68k_set_irq(io_link_vdp_irq);
+}
