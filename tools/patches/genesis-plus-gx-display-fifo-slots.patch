+/* Slot starts from the VDP horizontal counter. A refresh reserves one
+ * slot on the RAM side; bus DMA also loses the following source read.
+ * H32 refresh phases are approximate (five refreshes per scanline). */
+unsigned int vdp_blank_slots(int h40, int dma, unsigned short *times)
+{
+  const uint8 *counter = h40 ? cycle2hc40 : cycle2hc32;
+  unsigned int n = 0;
+  int t;
+  for (t = 0; t < MCYCLES_PER_LINE; ++t)
+  {
+    int h = counter[t];
+    if (t && h == counter[t - 1]) continue;
+    if (h40 && h == 0xe4) continue; /* mid-slot H counter discontinuity */
+    int offset = h - (h40 ? 26 : 19);
+    int extra = h - (h40 ? 250 : 243);
+    if ((offset >= 0 && offset < (h40 ? 130 : 98) && (offset & 31) <= dma) ||
+        (extra >= 0 && extra <= dma)) continue;
+    times[n++] = t;
+  }
+  return n;
+}
+
+/* A display-enable edge changes the bandwidth available to entries already
+ * queued. Retain their order and only move byte lanes still outstanding. */
+static void fifo_display_edge(unsigned int cycles, int enabled)
+{
+  static unsigned short blank_slots[2][204];
+  static unsigned int blank_count[2];
+  const int h40 = reg[12] & 1;
+  const unsigned short *slots = fifo_timing;
+  unsigned int count = dma_timing[0][h40];
+  unsigned int line = cycles - cycles % MCYCLES_PER_LINE;
+  unsigned int at = cycles - line;
+  if (!enabled)
+  {
+    if (!blank_count[h40])
+      blank_count[h40] = vdp_blank_slots(h40, 0, blank_slots[h40]);
+    slots = blank_slots[h40];
+    count = blank_count[h40];
+  }
+  unsigned int lo = 0, hi = count;
+  while (lo < hi)
+  {
+    unsigned int mid = (lo + hi) >> 1;
+    if (slots[mid] <= at) lo = mid + 1;
+    else hi = mid;
+  }
+  for (unsigned int j = 0; j < 4; ++j)
+  {
+    unsigned int i = (fifo_idx + j) & 3;
+    if (fifo_cycles[i] <= cycles) continue;
+    if (lo == count) { line += MCYCLES_PER_LINE; lo = 0; }
+    if (fifo_first_byte[i] > cycles)
+    {
+      fifo_first_byte[i] = line + slots[lo++];
+      if (lo == count) { line += MCYCLES_PER_LINE; lo = 0; }
+    }
+    fifo_cycles[i] = line + slots[lo++];
+  }
+}
