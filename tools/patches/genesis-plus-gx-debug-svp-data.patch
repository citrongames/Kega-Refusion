+
+INLINE uint16_t kr_debug_ssp_read_ram(unsigned word)
+{
+  const uint16_t value = ssp->mem.RAM[word];
+  if (UNLIKELY(kr_debug_ssp_mask & KR_DEBUG_READ))
+    kr_debug_ssp_data(KR_DEBUG_READ, KR_DEBUG_SSP_RAM0_BASE + (word << 1), value);
+  return value;
+}
+
+INLINE void kr_debug_ssp_write_ram(unsigned word, uint16_t value)
+{
+  ssp->mem.RAM[word] = value;
+  if (UNLIKELY(kr_debug_ssp_mask & KR_DEBUG_WRITE))
+    kr_debug_ssp_data(KR_DEBUG_WRITE, KR_DEBUG_SSP_RAM0_BASE + (word << 1), value);
+}
+
+INLINE uint16_t kr_debug_ssp_read_program(unsigned word)
+{
+  const uint16_t value = ((const unsigned short *)svp->iram_rom)[word];
+  if (UNLIKELY(kr_debug_ssp_mask & KR_DEBUG_READ))
+  {
+    const uint32_t base = word < 0x400 ? KR_DEBUG_SSP_IRAM_BASE : 0;
+    kr_debug_ssp_data(KR_DEBUG_READ, base + (word << 1), value);
+  }
+  return value;
+}
