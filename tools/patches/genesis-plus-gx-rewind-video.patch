+extern int kegarefusion_rewind_preview_active;
+extern int kegarefusion_rewind_needs_field;
+unsigned kegarefusion_preview_fields;
+static int kegarefusion_preview_width, kegarefusion_preview_height;
+
+/* A single transient native raster is sufficient for weave. It is never
+   included in rewind history. The LCD ghosting filter recursively depends on
+   every earlier output; previews instead seed its next real frame with raw T. */
+static void kegarefusion_preview_frame(void)
+{
+   if (!kegarefusion_rewind_preview_active) return;
+   if (!interlaced || !config.render)
+   {
+      kegarefusion_preview_fields = 0;
+      kegarefusion_preview_width = vwidth;
+      kegarefusion_preview_height = vheight;
+      return;
+   }
+   if (kegarefusion_preview_width != vwidth || kegarefusion_preview_height != vheight)
+      kegarefusion_preview_fields = 0;
+   kegarefusion_preview_width = vwidth;
+   kegarefusion_preview_height = vheight;
+   kegarefusion_preview_fields |= 1u << odd_frame;
+}
+
+static void kegarefusion_preview_copy_row(int from, int to)
+{
+   const size_t source = (size_t)from * bitmap.pitch;
+   const size_t target = (size_t)to * bitmap.pitch;
+   memmove(bitmap.data + target, bitmap.data + source, bitmap.pitch);
+   if (kega_recording_bitmap)
+      memmove(kega_recording_bitmap + target, kega_recording_bitmap + source, bitmap.pitch);
+   if (kega_sprite_hint_bitmap)
+      memmove(kega_sprite_hint_bitmap + (size_t)to * 720,
+            kega_sprite_hint_bitmap + (size_t)from * 720, 720);
+}
+
+static void kegarefusion_preview_bob(void)
+{
+   int y;
+   for (y = 0; y + 1 < vheight && y + 1 < bitmap.height; y += 2)
+      kegarefusion_preview_copy_row(y + odd_frame, y + (odd_frame ^ 1));
+}
+
+/* Commands: 0=query mode, 1=begin scope, 2=end scope,
+   3=finish rendered preview, 4=finish with a single current field. */
+RETRO_API unsigned retro_kegarefusion_rewind_video(unsigned command)
+{
+   if (command == 1)
+   {
+      kegarefusion_rewind_preview_active = 1;
+      kegarefusion_preview_fields = 0;
+      kegarefusion_preview_width = kegarefusion_preview_height = 0;
+   }
+   else if (command == 2)
+   {
+      /* A pending progressive-to-weave switch needs a legal previous field
+         for the next real frame too. Seed it from transient raw T, without
+         altering the already published progressive preview. */
+      if (kegarefusion_rewind_preview_active && config.render && !interlaced && (reg[12] & 2))
+      {
+         int y, height = vheight;
+         if (height > bitmap.height / 2) height = bitmap.height / 2;
+         for (y = height - 1; y >= 0; y--)
+         {
+            kegarefusion_preview_copy_row(y, y * 2);
+            kegarefusion_preview_copy_row(y * 2, y * 2 + 1);
+         }
+      }
+      kegarefusion_rewind_preview_active = 0;
+   }
+   else if ((command == 3 || command == 4) && kegarefusion_rewind_preview_active)
+   {
+      if (interlaced && config.render &&
+          (command == 4 || kegarefusion_preview_fields != 3))
+      {
+         /* A changed viewport or repeated parity cannot borrow an unrelated
+            field. Duplicate only the actual current field. */
+         kegarefusion_preview_bob();
+      }
+      kegarefusion_rewind_needs_field = 0;
+      video_cb(bitmap.data + bmdoffset, vwidth - vwoffset, vheight, 720 * 2);
+   }
+   return (interlaced && config.render ? 1u : 0u) | (config.lcd ? 2u : 0u);
+}
