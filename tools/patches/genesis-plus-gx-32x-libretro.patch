+static bool kegarefusion_read_32x_bios(const char *dir, const char *name, uint8_t *data, size_t length)
+{
+   char path[1024];
+   FILE *file;
+   bool okay;
+   fill_pathname_join(path, dir, name, sizeof(path));
+   file = fopen(path, "rb");
+   if (!file) return false;
+   okay = fread(data, 1, length, file) == length && fgetc(file) == EOF && !ferror(file);
+   fclose(file);
+   return okay;
+}
+static bool kegarefusion_load_32x(const char *dir, const char *extension)
+{
+   uint8_t g[256], m[2048], s[1024];
+   if (memcmp(rominfo.consoletype, "SEGA 32X", 8) != 0 && strcasecmp(extension, "32x") != 0)
+      return true;
+   if (!kegarefusion_read_32x_bios(dir, "32X_G_BIOS.BIN", g, sizeof(g)) ||
+       !kegarefusion_read_32x_bios(dir, "32X_M_BIOS.BIN", m, sizeof(m)) ||
+       !kegarefusion_read_32x_bios(dir, "32X_S_BIOS.BIN", s, sizeof(s)))
+   {
+      if (log_cb) log_cb(RETRO_LOG_ERROR, "32X requires complete G/M/S BIOS in the system directory.\n");
+      return false;
+   }
+   if (!kegarefusion_32x_attach(g, m, s)) return false;
+   return kegarefusion_32x_prepare_filter() != 0;
+}
