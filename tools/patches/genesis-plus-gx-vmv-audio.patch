+/* Match the canonical first 64 KiB used by PicoDrive's cartridge database.
+ * Ignore only the optional checksum header correction. READ_BYTE makes this
+ * independent of the host/core ROM byte order; no ROM bytes are changed. */
+static int md_cart_vmv_z80_bus_quirk(void)
+{
+  uint8 block[1024];
+  uint32 crc = 0;
+  unsigned int offset, i;
+  if ((cart.romsize != 0x100000) && (cart.romsize != 0x200000)) return 0;
+  for (offset = 0; offset < 0x10000; offset += sizeof(block))
+  {
+    for (i = 0; i < sizeof(block); i++)
+      block[i] = READ_BYTE(cart.rom, offset + i);
+    if (!offset) block[0x18e] = block[0x18f] = 0;
+    crc = crc32(crc, block, sizeof(block));
+  }
+  /* Ben 10, Mario 3 Around the World (full), Mario 4 Space Odyssey.
+   * Original prefix CRCs: E302585A / 20ED0DE8. The latter becomes B8C4FF2D
+   * after excluding the checksum field. Demo revisions are not implied. */
+  return ((cart.romsize == 0x100000) && (crc == 0x6732aab4)) ||
+         ((cart.romsize == 0x200000) && ((crc == 0xe302585a) || (crc == 0xb8c4ff2d)));
+}
