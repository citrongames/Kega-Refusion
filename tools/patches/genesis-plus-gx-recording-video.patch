+/* The returned raster is borrowed until the next run/disable/deinit. Pixel
+ * mapping is performed alongside scanline output, before NTSC/LCD filtering. */
+RETRO_API bool retro_kegarefusion_recording_video(bool enabled)
+{
+   if (!enabled)
+   {
+      free(kega_recording_bitmap);
+      kega_recording_bitmap = NULL;
+      kega_recording_frame_ready = false;
+      return true;
+   }
+   if (!kega_recording_bitmap)
+   {
+      if (bitmap.pitch <= 0 || bitmap.height <= 0) return false;
+      kega_recording_bitmap = calloc((size_t)bitmap.height, (size_t)bitmap.pitch);
+      kega_recording_frame_ready = false;
+   }
+   return kega_recording_bitmap != NULL;
+}
+RETRO_API bool retro_kegarefusion_recording_frame(const void **data,
+      unsigned *width, unsigned *height, size_t *pitch, unsigned *format)
+{
+   unsigned crop;
+   if (!data || !width || !height || !pitch || !format ||
+       !kega_recording_bitmap || !kega_recording_frame_ready ||
+       !retro_kegarefusion_native_video_size(width, height)) return false;
+   crop = config.ntsc ? bmdoffset * 2 / 5 : bmdoffset;
+   if (*width > (unsigned)bitmap.width || *height > (unsigned)bitmap.height ||
+       crop + *width * sizeof(uint16_t) > (unsigned)bitmap.pitch) return false;
+   *data = kega_recording_bitmap + crop;
+   *pitch = bitmap.pitch;
+#ifdef FRONTEND_SUPPORTS_RGB565
+   *format = RETRO_PIXEL_FORMAT_RGB565;
+#else
+   *format = RETRO_PIXEL_FORMAT_0RGB1555;
+#endif
+   return true;
+}
