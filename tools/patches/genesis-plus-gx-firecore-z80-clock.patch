+static uint16 firecore_z80_clock;
+
+void md_cart_firecore_apply_z80_clock(void)
+{
+#ifdef Z80_OVERCLOCK_SHIFT
+  /* RedKid mode 4 drives the Z80 PCM loop faster. This ratio is calibrated
+   * against the 12 kHz source samples in DMC games; other divider modes
+   * have not been measured. The FM and PSG oscillators are independent. */
+  const uint32 normal = 1u << Z80_OVERCLOCK_SHIFT;
+  z80_cycle_ratio = (firecore_z80_clock == 4) ? normal * 17 / 30 : normal;
+#endif
+}
+
+static void firecore_set_z80_clock(unsigned int value)
+{
+  firecore_z80_clock = value;
+  md_cart_firecore_apply_z80_clock();
+}
 
 /* Two 8 MiB flash chips share the window on RedKid boards. The ROM dump
  * concatenates them; each chip begins with its own executable image. */
@@ -798,8 +816,23 @@
 
 static unsigned int firecore_io_read(unsigned int address)
 {
-  (void)address;
-  return 0;
+  return ((address & 0xffff) == 0x12) ? firecore_z80_clock : 0;
+}
+
+static unsigned int firecore_io_read_byte(unsigned int address)
+{
+  const unsigned word = firecore_io_read(address & ~1u);
+  return (address & 1) ? (word & 0xff) : (word >> 8);
+}
+
+static void firecore_io_write_byte(unsigned int address, unsigned int data)
+{
+  switch (address & 0xffff)
+  {
+    case 0x12: firecore_set_z80_clock((firecore_z80_clock & 0xff) | (data << 8)); break;
+    case 0x13: firecore_set_z80_clock((firecore_z80_clock & 0xff00) | data); break;
+    default: m68k_unused_8_w(address, data); break;
+  }
 }
 
