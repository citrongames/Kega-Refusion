+static uint16 firecore_m68k_divider;
+#ifdef M68K_OVERCLOCK_SHIFT
+static unsigned int firecore_m68k_base_ratio = 1u << M68K_OVERCLOCK_SHIFT;
+#endif
+
+void md_cart_firecore_set_m68k_base_ratio(unsigned int ratio)
+{
+#ifdef M68K_OVERCLOCK_SHIFT
+  /* The RedKid clock source is 27 MHz. The console firmware and games use
+   * divider 3 (9 MHz) and 2 (13.5 MHz). Preserve the frontend multiplier. */
+  firecore_m68k_base_ratio = ratio;
+  if (firecore_m68k_divider == 2 || firecore_m68k_divider == 3)
+    ratio = (uint32)(((uint64_t)ratio * system_clock * firecore_m68k_divider) / (7u * 27000000u));
+  m68k.cycle_ratio = ratio;
+#endif
+}
+
+static void firecore_set_m68k_divider(uint16 value)
+{
+  firecore_m68k_divider = value;
+#ifdef M68K_OVERCLOCK_SHIFT
+  md_cart_firecore_set_m68k_base_ratio(firecore_m68k_base_ratio);
+#endif
+}
 
