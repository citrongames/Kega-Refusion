+/* SDK99 revisions share the original executable code and the late protection
+ * producer/consumer. Header corrections and translated graphics must keep the
+ * original register hardware; no per-variant database entries or ROM edits. */
+static int md_cart_sdk99_hardware(const uint8 *rom, size_t size, int native_order)
+{
+  static const uint8 producer[] = {0x42,0x82,0x45,0xf9,0x00,0x00,0x5b,0x28};
+  static const uint8 ports[] = {0x00,0x68,0x00,0xf1,0x00,0x68,0x00,0xf3,
+                              0x00,0x68,0x00,0xf5,0x00,0x61,0xee,0xe3};
+  static const uint8 ending[] = {0x12,0x14,0x0c,0x01,0x00,0x8c,0x67,0x00,0x00,0x0a,
+                               0x33,0xfc,0x00,0x0a,0x00,0xff,0x00,0xe6};
+  const struct { unsigned offset, length; const uint8 *bytes; } signatures[] = {
+    {0x5ad2, sizeof(producer), producer}, {0x5b28, sizeof(ports), ports},
+    {0x14e6, sizeof(ending), ending}
+  };
+  uint8 block[1024];
+  uint32 crc = 0;
+  unsigned i, j, offset, count;
+  if (size != 0x200000) return 0;
+  for (i = 0; i < sizeof(signatures)/sizeof(signatures[0]); i++)
+    for (j = 0; j < signatures[i].length; j++)
+    {
+      offset = signatures[i].offset + j;
+      if ((native_order ? READ_BYTE(rom, offset) : rom[offset]) != signatures[i].bytes[j])
+        return 0;
+    }
+  /* Canonical executable prefix excludes all mutable header bytes. A different
+   * King Kong 99 program has a different code CRC and retains its own DB row. */
+  for (offset = 0x200; offset < 0x10000; offset += count)
+  {
+    count = 0x10000 - offset;
+    if (count > sizeof(block)) count = sizeof(block);
+    for (i = 0; i < count; i++)
+      block[i] = native_order ? READ_BYTE(rom, offset + i) : rom[offset + i];
+    crc = crc32(crc, block, count);
+  }
+  return crc == 0x2419c93c;
+}
