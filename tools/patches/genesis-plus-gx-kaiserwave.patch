+
+/* The legacy rompath is truncated at 255 bytes. Retain just the directory
+ * supplied by the frontend for the lifetime of a Kaiser Wave cartridge. */
+static char *kr_yx5200_directory;
+
+const char *kr_yx5200_rom_directory(void)
+{
+   return kr_yx5200_directory;
+}
+
+static void kr_yx5200_close(void)
+{
+   yx5200_reset();
+   free(kr_yx5200_directory);
+   kr_yx5200_directory = NULL;
+}
+
+static void kr_yx5200_set_directory(const struct retro_game_info_ext *ext, const char *path)
+{
+   size_t length;
+   const char *source;
+   if (ext && ext->dir && *ext->dir)
+   {
+      source = ext->dir;
+      length = strlen(source);
+   }
+   else if (path)
+   {
+      source = path;
+      length = strlen(path);
+      while (length && path[length-1] != '/' && path[length-1] != '\\') --length;
+   }
+   else return;
+   if (!length) { source = "."; length = 1; }
+   kr_yx5200_directory = malloc(length + 2);
+   if (!kr_yx5200_directory) return;
+   memcpy(kr_yx5200_directory, source, length);
+   if (source[length-1] != '/' && source[length-1] != '\\')
+      kr_yx5200_directory[length++] = '/';
+   kr_yx5200_directory[length] = 0;
+}
 
