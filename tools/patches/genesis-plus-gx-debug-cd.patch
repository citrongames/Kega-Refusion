+#include "../kegadebug/hooks.h"
+
+int kr_debug_peek_cd(unsigned cpu, uint32_t address, uint8_t *byte)
+{
+  unsigned page = address >> 16;
+  const cpu_memory_map *map = cpu == KR_DEBUG_SUB68K ? s68k.memory_map : m68k.memory_map;
+  unsigned int (*read_byte)(unsigned int) = cpu == KR_DEBUG_Z80 ?
+      zbank_memory_map[page].read : map[page].read8;
+
+  /* The mirror base can retain an old bank. Follow the same redirect as the
+   * actual byte bus using only its current map and known pure transforms. */
+  if (read_byte == word_ram_s68k_read_byte)
+    page &= 0x0f;
+  else if (read_byte == word_ram_m68k_read_byte || read_byte == word_ram_z80_read_byte)
+    page &= 0x23;
+  else if (read_byte == prg_ram_m68k_read_byte || read_byte == prg_ram_z80_read_byte)
+    page &= 0x03;
+
+  read_byte = cpu == KR_DEBUG_Z80 ? zbank_memory_map[page].read : map[page].read8;
+  if (!read_byte && map[page].base)
+  {
+    *byte = READ_BYTE(map[page].base, address & 0xffff);
+    return 1;
+  }
+  if (read_byte == bram_read_byte)
+  {
+    *byte = bram_byte(address);
+    return 1;
+  }
+  return kr_debug_peek_cd_graphics(read_byte, address, byte);
+}
