diff --git a/core/sound/ym2612.c b/core/sound/ym2612.c
--- a/core/sound/ym2612.c
+++ b/core/sound/ym2612.c
@@ -2309,3 +2309,31 @@
          offsetof(FM_SLOT, DT) == 0 && sizeof(FM_CH) == 400 &&
          offsetof(FM_CH, connect1) == 336;
 }
+
+#include "../kegainspect/values.h"
+
+void kr_inspect_ym2612(kr_inspect_info *info)
+{
+  const unsigned part = KR_INSPECT_AUDIO;
+  const FM_ST *state = &ym2612.OPN.ST;
+  kr_inspect_put(info, part, "YM2612 (MAME)", "Timer flags", 2, state->status & 3);
+  kr_inspect_put(info, part, "YM2612 (MAME)", "Timer A reload", 3, state->TA);
+  kr_inspect_put(info, part, "YM2612 (MAME)", "Timer B reload", 2, state->TB);
+  kr_inspect_put(info, part, "YM2612 (MAME)", "Channel 3 mode", 1, (state->mode >> 6) & 3);
+  kr_inspect_put(info, part, "YM2612 (MAME)", "DAC enabled", 0, !!ym2612.dacen);
+  kr_inspect_put(info, part, "YM2612 (MAME)", "DAC data latch", 2, (ym2612.dacout / 64 + 0x80) & 0xff);
+  for (unsigned i = 0; i < 6; ++i)
+  {
+    char device[24];
+    const FM_CH *ch = &ym2612.CH[i];
+    const unsigned keys = ch->SLOT[SLOT1].key | (ch->SLOT[SLOT2].key << 1) |
+                         (ch->SLOT[SLOT3].key << 2) | (ch->SLOT[SLOT4].key << 3);
+    snprintf(device, sizeof(device), "YM2612 ch %u", i + 1);
+    kr_inspect_put(info, part, device, "F-number", 3, ch->block_fnum & 0x7ff);
+    kr_inspect_put(info, part, device, "Block", 0, ch->block_fnum >> 11);
+    kr_inspect_put(info, part, device, "Algorithm", 0, ch->ALGO);
+    kr_inspect_put(info, part, device, "Operator key mask", 1, keys);
+    kr_inspect_put(info, part, device, "Stereo mask (L:R)", 1,
+        (!!ym2612.OPN.pan[2 * i] << 1) | !!ym2612.OPN.pan[2 * i + 1]);
+  }
+}
