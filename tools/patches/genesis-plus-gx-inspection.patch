diff --git a/core/cart_hw/md_cart.c b/core/cart_hw/md_cart.c
--- a/core/cart_hw/md_cart.c
+++ b/core/cart_hw/md_cart.c
@@ -3433,3 +3433,54 @@
   if (address & 0x0e) mapper_512k_w(address, data);
   else mapper_sega_w(data);
 }
+
+#include "../kegainspect/values.h"
+
+void kr_inspect_md_cart(kr_inspect_info *info, unsigned parts)
+{
+  if (parts & KR_INSPECT_HARDWARE)
+  {
+    const unsigned part = KR_INSPECT_HARDWARE;
+    if (kr_firecore_active)
+    {
+      kr_inspect_put(info, part, "Firecore", "ROM window offset", 8, firecore_offset);
+      kr_inspect_put(info, part, "Firecore", "GPIO latch", 4, firecore_gpio);
+      kr_inspect_put(info, part, "Firecore", "Z80 clock register", 4, firecore_z80_clock);
+      kr_inspect_put(info, part, "Firecore", "68000 divider register", 4, firecore_m68k_divider);
+    }
+    if (cart.hw.regs_r || cart.hw.regs_w)
+    {
+      for (unsigned i = 0; i < 4; ++i)
+      {
+        char name[24];
+        snprintf(name, sizeof(name), "Register shadow %u", i);
+        kr_inspect_put(info, part, "MD cartridge", name, 2, cart.hw.regs[i]);
+      }
+    }
+    if (sram.on)
+    {
+      kr_inspect_put(info, part, "Cartridge save", "Storage type", 0, sram.type);
+      if (sram.type == DEFAULT_SRAM)
+      {
+        kr_inspect_put(info, part, "Cartridge save", "Mapped start", 6, sram.start);
+        kr_inspect_put(info, part, "Cartridge save", "Mapped end", 6, sram.end);
+      }
+    }
+  }
+  if ((parts & KR_INSPECT_AUDIO) && kr_firecore_active)
+    kr_inspect_put(info, KR_INSPECT_AUDIO, "Firecore audio", "DMC PCM option", 0, !!kr_firecore_dmc_pcm);
+  if ((parts & KR_INSPECT_AUDIO) && paprium_active())
+  {
+    const unsigned part = KR_INSPECT_AUDIO;
+    kr_inspect_put(info, part, "Paprium music", "External track", 0, (uint8)punchium_s.music_track);
+    kr_inspect_put(info, part, "Paprium music", "Decoded source available", 0, punchium_track.total_samples != 0);
+    if (punchium_track.total_samples)
+    {
+      kr_inspect_put(info, part, "Paprium music", "Position (frames)", 0, (uint32)punchium_s.music_pos);
+      kr_inspect_put(info, part, "Paprium music", "Track length (frames)", 0, punchium_track.total_samples);
+      kr_inspect_put(info, part, "Paprium music", "Sample rate (Hz)", 0, punchium_track.sample_rate);
+    }
+    kr_inspect_put(info, part, "Paprium music", "Music volume", 2, (uint32)punchium_s.music_volume);
+    kr_inspect_put(info, part, "Paprium music", "SFX volume", 2, (uint32)punchium_s.sfx_volume);
+  }
+}
