diff --git a/core/sound/psg.c b/core/sound/psg.c
--- a/core/sound/psg.c
+++ b/core/sound/psg.c
@@ -569,3 +569,41 @@
     psg.polarity[i] = polarity;
   }
 }  
+
+#include "../kegainspect/values.h"
+
+void kr_inspect_psg(kr_inspect_info *info)
+{
+  const unsigned part = KR_INSPECT_AUDIO;
+  static const char *const names[8] = {
+    "Tone 1 period", "Tone 1 attenuation", "Tone 2 period", "Tone 2 attenuation",
+    "Tone 3 period", "Tone 3 attenuation", "Noise control", "Noise attenuation"
+  };
+  for (unsigned i = 0; i < 8; ++i)
+  {
+    int value = psg.regs[i];
+    unsigned digits = 3;
+    if (i & 1)
+    {
+      /* The synthesis state retains the amplitude, not the written nibble. */
+      const unsigned levels = sizeof(chanVolume) / sizeof(chanVolume[0]);
+      unsigned attenuation = 0;
+      while (attenuation < levels && chanVolume[attenuation] != value)
+        ++attenuation;
+      if (attenuation == levels)
+        continue;
+      value = attenuation;
+      digits = 1;
+    }
+    else if (i == 6)
+    {
+      value &= 7;
+      digits = 1;
+    }
+    kr_inspect_put(info, part, "PSG", names[i], digits, value);
+  }
+  kr_inspect_put(info, part, "PSG", "Register latch", 1, psg.latch);
+  kr_inspect_put(info, part, "PSG", "Noise shift register", 4, psg.noiseShiftValue);
+  if (system_hw == SYSTEM_GG)
+    kr_inspect_put(info, part, "PSG", "Stereo control", 2, io_reg[6]);
+}
diff --git a/core/sound/sound.c b/core/sound/sound.c
--- a/core/sound/sound.c
+++ b/core/sound/sound.c
@@ -858,3 +858,63 @@
     }
   }
 }
+
+#include "../kegainspect/values.h"
+
+void kr_inspect_fm(kr_inspect_info *info)
+{
+  const unsigned part = KR_INSPECT_AUDIO;
+  if ((system_hw & SYSTEM_PBC) == SYSTEM_MD)
+  {
+#ifdef HAVE_YM3438_CORE
+    if (config.ym3438)
+    {
+      const char *device = config.ym3438 == 1 ? "YM2612 (Nuked)" : "YM3438 (Nuked)";
+      kr_inspect_put(info, part, device, "Timer flags", 2,
+          ym3438.timer_a_overflow_flag | (ym3438.timer_b_overflow_flag << 1));
+      kr_inspect_put(info, part, device, "Timer A reload", 3, ym3438.timer_a_reg);
+      kr_inspect_put(info, part, device, "Timer B reload", 2, ym3438.timer_b_reg);
+      kr_inspect_put(info, part, device, "Channel 3 mode", 1, ym3438.mode_ch3);
+      kr_inspect_put(info, part, device, "DAC enabled", 0, !!ym3438.dacen);
+      kr_inspect_put(info, part, device, "DAC data latch", 2, ((ym3438.dacdata >> 1) ^ 0x80) & 0xff);
+      for (unsigned i = 0; i < 6; ++i)
+      {
+        char name[24];
+        const unsigned keys = ym3438.mode_kon[i] | (ym3438.mode_kon[i + 12] << 1) |
+            (ym3438.mode_kon[i + 6] << 2) | (ym3438.mode_kon[i + 18] << 3);
+        snprintf(name, sizeof(name), "%s ch %u", config.ym3438 == 1 ? "YM2612" : "YM3438", i + 1);
+        kr_inspect_put(info, part, name, "F-number", 3, ym3438.fnum[i]);
+        kr_inspect_put(info, part, name, "Block", 0, ym3438.block[i]);
+        kr_inspect_put(info, part, name, "Algorithm", 0, ym3438.connect[i]);
+        kr_inspect_put(info, part, name, "Operator key mask", 1, keys);
+        kr_inspect_put(info, part, name, "Stereo mask (L:R)", 1, (ym3438.pan_l[i] << 1) | ym3438.pan_r[i]);
+      }
+      return;
+    }
+#endif
+    kr_inspect_ym2612(info);
+    return;
+  }
+
+  if ((system_hw != SYSTEM_MARKIII && system_hw != SYSTEM_SMS &&
+       system_hw != SYSTEM_SMS2 && system_hw != SYSTEM_PBC) ||
+      !(config.ym2413 & 1) || !YM_Update)
+    return;
+#ifdef HAVE_OPLL_CORE
+  if (config.opll)
+  {
+    kr_inspect_put(info, part, "YM2413 (Nuked)", "Rhythm register", 2, opll.rhythm);
+    for (unsigned i = 0; i < 9; ++i)
+    {
+      char device[24];
+      snprintf(device, sizeof(device), "YM2413 ch %u", i + 1);
+      kr_inspect_put(info, part, device, "F-number", 3, opll.fnum[i]);
+      kr_inspect_put(info, part, device, "Block", 0, opll.block[i]);
+      kr_inspect_put(info, part, device, "Instrument / volume register", 2, (opll.inst[i] << 4) | opll.vol[i]);
+      kr_inspect_put(info, part, device, "Melodic key on", 0, opll.kon[i]);
+    }
+    return;
+  }
+#endif
+  kr_inspect_ym2413(info);
+}
