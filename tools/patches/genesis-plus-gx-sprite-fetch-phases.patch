+/* Phase 1 already built the common, unchanged-SAT result. Re-fetch only
+ * after an intervening SAT/cache write or base-register change. No CPU slice
+ * is added: this completes immediately after the existing line execution. */
+void render_sprite_phase2(void)
+{
+  int i, line = v_counter + 1;
+  unsigned int bank, pending;
+  object_info_t *objects;
+  uint16 *q = (uint16 *)&sat[0];
+  uint16 *p = (uint16 *)&vram[satb];
+  if (!(reg[1] & 4) || kr_firecore_active)
+  {
+    sprite_phase_pending = 0;
+    return;
+  }
+  if (v_counter == lines_per_frame - 1) line = 0;
+  if (line >= bitmap.viewport.h) return;
+  bank = line & 1;
+  pending = 1u << bank;
+  if (!(sprite_phase_pending & pending)) return;
+  sprite_phase_pending &= ~pending;
+  if (sprite_phase_revision[bank] == kega_vdp_sat_revision) return;
+  objects = obj_info[bank];
+  for (i = 0; i < object_count[bank]; i++)
+  {
+    const unsigned int link = sprite_phase_link[bank][i];
+    const unsigned int target = im2_flag ? ((line + 0x80) << 1) + odd_frame : line + 0x80;
+    object_info_t *object = &objects[i];
+    object->ypos = (target - q[link]) & (im2_flag ? 0x3f : 0x1f);
+    object->size = (q[link + 1] >> 8) & 15;
+    object->attr = p[link + 2];
+    object->xpos = p[link + 3] & 0x1ff;
+  }
+}
 
