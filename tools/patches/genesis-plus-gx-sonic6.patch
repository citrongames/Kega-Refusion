+/* Observed Sonic Jam 6 CRC04F0C93E banking protocol. Scoped to this dump;
+ * undocumented board modes are not inferred. Original ROM remains unchanged. */
+#include "shared.h"
+#include <stdlib.h>
+uint8 md_cart_sonic6_active;
+static uint8 mask, code_mode;
+static uint8 *pages[6];
+static const uint8 banks[5]={0,1,4,9,12};
+static const uint16 within[5]={0x8000,0,0,0x6000,0xa000};
+static const uint32 physical[5]={0x2000,0x20000,0x20000,0xf0000,0xf0000};
+static void (*under_write8)(unsigned int,unsigned int);
+static void (*under_write16)(unsigned int,unsigned int);
+static void (*under_zwrite)(unsigned int,unsigned int);
+static int prepare(uint8 wanted,uint8 mode)
+{
+  unsigned i;
+  for(i=0;i<5;i++)if((wanted&(1u<<i))&&!pages[i])
+  {pages[i]=(uint8*)malloc(0x10000);if(!pages[i])return 0;}
+  if(mode&&!pages[5]){pages[5]=(uint8*)malloc(0x10000);if(!pages[5])return 0;}
+  return 1;
+}
+void md_cart_sonic6_rebuild(void)
+{
+  unsigned i;
+  if(!md_cart_sonic6_active)return;
+  for(i=0;i<5;i++)
+  {
+    if(mask&(1u<<i))
+    {
+      memcpy(pages[i],cart.rom+((uint32)banks[i]<<16),0x10000);
+      memcpy(pages[i]+within[i],cart.rom+physical[i],0x2000);
+      m68k.memory_map[banks[i]].base=pages[i];
+    }
+    else m68k.memory_map[banks[i]].base=cart.rom+((uint32)banks[i]<<16);
+  }
+  if(code_mode)
+  {
+    memcpy(pages[5],cart.rom+0x1a0000,0x10000);
+    memcpy(pages[5]+(code_mode==1?0x2000:0xa000),
+           cart.rom+(code_mode==1?0x1c4000:0x1c6000),0x2000);
+    m68k.memory_map[0x1a].base=pages[5];
+  }
+  else m68k.memory_map[0x1a].base=cart.rom+0x1a0000;
+}
+static int control(uint32 address,uint32 data)
+{
+  uint8 next_mask=mask,next_mode=code_mode;
+  switch(address)
+  {
+    case 0x408000:if(data==0x100)next_mask|=1;break;
+    case 0x4080f0:if(data==0x100)next_mode=1;break;
+    case 0x408100:case 0x40a100:if(data==0){next_mask=0;next_mode=0;}break;
+    case 0x408600:if(data==0x100){next_mask|=2;next_mode=2;}break;
+    case 0x4088f0:if(data==0x300)next_mask|=4;break;
+    case 0x409f00:if(data==0x200)next_mask|=8;break;
+    case 0x40a000:if(data==0x100)next_mode=1;else if(data==0x200)next_mask|=16;break;
+    default:return 0;
+  }
+  if((next_mask!=mask||next_mode!=code_mode)&&prepare(next_mask,next_mode))
+  {mask=next_mask;code_mode=next_mode;md_cart_sonic6_rebuild();}
+  return 1;
+}
+static void write8(uint32 address,uint32 data)
+{
+  /* Observed commands use the upper byte lane. */
+  if(!(address&1)&&control(address,(data&0xff)<<8))return;
+  if(under_write8)under_write8(address,data);
+}
+static void write16(uint32 address,uint32 data)
+{if(!control(address,data&0xffff)&&under_write16)under_write16(address,data);}
+static void zwrite(uint32 address,uint32 data)
+{
+  if(!(address&1)&&control(address,(data&0xff)<<8))return;
+  if(under_zwrite)under_zwrite(address,data);
+}
+void md_cart_sonic6_map(void)
+{
+  if(!md_cart_sonic6_active)return;
+  if(m68k.memory_map[0x40].write16!=write16)
+  {
+    under_write8=m68k.memory_map[0x40].write8;
+    under_write16=m68k.memory_map[0x40].write16;
+    under_zwrite=zbank_memory_map[0x40].write;
+    m68k.memory_map[0x40].write8=write8;
+    m68k.memory_map[0x40].write16=write16;
+    zbank_memory_map[0x40].write=zwrite;
+  }
+  md_cart_sonic6_rebuild();
+}
+void md_cart_sonic6_release(void)
+{
+  unsigned i;for(i=0;i<6;i++){free(pages[i]);pages[i]=NULL;}
+  md_cart_sonic6_active=mask=code_mode=0;under_write8=under_write16=under_zwrite=NULL;
+}
+void md_cart_sonic6_reset(void)
+{if(md_cart_sonic6_active){mask=code_mode=0;md_cart_sonic6_rebuild();}}
+int md_cart_sonic6_mapped_bank(unsigned bank)
+{
+  unsigned i;if(!md_cart_sonic6_active)return 0;if(bank==0x1a)return 1;
+  for(i=0;i<5;i++)if(bank==banks[i])return 1;return 0;
+}
+int md_cart_sonic6_state_valid(const uint8 *s)
+{
+  uint32 expected;if(memcmp(s,"KRSJ6MAP",8))return 1;
+  if(s[8]!=1||s[9]||s[10]||s[11]!=MD_CART_COMPAT_STATE_SIZE||s[16]>31||s[17]>2)return 0;
+  expected=((uint32)s[12]<<24)|((uint32)s[13]<<16)|((uint32)s[14]<<8)|s[15];
+  if(crc32(0,s+16,MD_CART_COMPAT_STATE_SIZE-16)!=expected)return 0;
+  return prepare(s[16],s[17]);
+}
+void md_cart_sonic6_state_save(uint8 *s)
+{
+  uint32 crc;memset(s,0,MD_CART_COMPAT_STATE_SIZE);memcpy(s,"KRSJ6MAP",8);
+  s[8]=1;s[11]=MD_CART_COMPAT_STATE_SIZE;s[16]=mask;s[17]=code_mode;
+  crc=crc32(0,s+16,MD_CART_COMPAT_STATE_SIZE-16);
+  s[12]=crc>>24;s[13]=crc>>16;s[14]=crc>>8;s[15]=crc;
+}
+void md_cart_sonic6_state_load(const uint8 *s)
+{
+  mask=code_mode=0;if(!memcmp(s,"KRSJ6MAP",8)){mask=s[16];code_mode=s[17];}
+  md_cart_sonic6_map();
+}
