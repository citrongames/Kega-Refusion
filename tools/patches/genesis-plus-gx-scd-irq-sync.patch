+#ifdef S68K_IRQ_AT_INSTRUCTION_END
+  if (m68ki_cpu.cycle_end && (CPU_INT_LEVEL > FLAG_INT_MASK))
+  {
+    uint start = m68ki_cpu.cycles;
+    uint elapsed;
+    USE_CYCLES(CYC_INSTRUCTION[REG_IR]);
+    elapsed = m68ki_cpu.cycles - start;
+    if (m68ki_cpu.cycles < m68ki_cpu.cycle_end)
+      m68ki_check_interrupts();
+    /* The runner accounts for the opcode once, after its handler returns.
+     * Preserve any exception cycles added by the IRQ above. A request past
+     * the run boundary remains pending for the next runner entry. */
+    m68ki_cpu.cycles -= elapsed;
+    return;
+  }
