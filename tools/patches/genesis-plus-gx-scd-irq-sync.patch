Sega CD interrupt synchronization, shared by CD and CD+32X.
Backports upstream 37b8bbd807f2b05a903664b958102319b4ec43ac and
939ce4f045f981f89965f24780cef045cc5e52d7 (ekeeke, Genesis Plus GX).
Extend the same IFL2 behavior to word access; do not release hardware stops.
No state layout changes. CD-only deterministic execution ABI suffix.

--- a/core/mem68k.c
+++ b/core/mem68k.c
@@ -407,6 +407,13 @@
           return scd.regs[0x0f>>1].byte.l;
         }
 
+        /* SUB-CPU interrupt acknowledge can clear IFL2 between MAIN-CPU reads. */
+        if (index == 0x00)
+        {
+          s68k_sync();
+          return scd.regs[0x00>>1].byte.h;
+        }
+
         /* default registers */
         if (index < 0x30)
         {
@@ -582,6 +589,13 @@
         if (index == 0x04)
         {
           return (scd.regs[index >> 1].byte.h << 8);
+        }
+
+        /* SUB-CPU interrupt acknowledge can clear IFL2 between MAIN-CPU reads. */
+        if (index == 0x00)
+        {
+          s68k_sync();
+          return scd.regs[0x00>>1].w;
         }
 
         /* default registers */
@@ -714,8 +728,9 @@
               /* level 2 interrupt enabled ? */
               if (scd.regs[0x32>>1].byte.l & 0x04)
               {
-                /* sync SUB-CPU with MAIN-CPU (fixes Earnest Evans, Fhey Area) */
-                s68k_sync();
+                /* Wake register-poll idle on IRQ, but preserve hardware bus/reset stops. */
+                if (!(s68k.stopped & 7))
+                  m68k_poll_sync(0xfffffff8);
 
                 /* set IFL2 flag */
                 scd.regs[0x00].byte.h |= 0x01;
@@ -1174,6 +1189,10 @@
               /* level 2 interrupt enabled ? */
               if (scd.regs[0x32>>1].byte.l & 0x04)
               {
+                /* Word access raises the same IFL2 line after control bits settle. */
+                if (!(s68k.stopped & 7))
+                  m68k_poll_sync(0xfffffff8);
+
                 /* set IFL2 flag */
                 scd.regs[0x00].byte.h |= 0x01;
 
