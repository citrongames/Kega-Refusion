+/* Read-only preflight: identify EEPROM entries whose header checksum is a key.
+ * The start-vector test is intentionally omitted, so uncertain cases keep the
+ * original header rather than losing the EEPROM mapping. */
+int eeprom_i2c_header_checksum_key(const char *product, unsigned checksum)
+{
+  unsigned int i;
+  if (!product) return 1;
+  for (i=0; i<(sizeof(i2c_database)/sizeof(T_I2C_GAME)); i++)
+  {
+    if (i2c_database[i].chk && (i2c_database[i].chk == checksum) &&
+        strstr(product, i2c_database[i].id))
+      return 1;
+  }
+  return 0;
+}
