+/* Optional frame-boundary extension in unused native-state space. Keep only
+ * live impulse tails (and any whole samples waiting for the next mix). */
+enum { rewind_audio_header = 88, rewind_eq_bytes = 256 };
+void audio_rewind_save(uint8 *out, unsigned int capacity)
+{
+  unsigned int i, size, cursor = rewind_audio_header;
+  if (capacity < rewind_audio_header || blip_link_state_size() != 168) return;
+  memset(out, 0, rewind_audio_header);
+  if (!sound_link_state_save(out + 48, 16)) return;
+  for (i = 0; i < 4; i++)
+  {
+    if (!snd.blips[i]) continue;
+    size = 168 + 8 * blip_samples_avail(snd.blips[i]);
+    if (size > capacity - cursor || !blip_link_state_save(snd.blips[i], out + cursor, size)) return;
+    link_wire_put32(out + 64 + i * 4, size);
+    cursor += size;
+  }
+  if (config.filter & 2)
+  {
+    double *fields[32];
+    if (capacity - cursor < rewind_eq_bytes) return;
+    audio_link_eq_fields(fields);
+    for (i = 0; i < 32; i++) link_wire_put_double(out + cursor + i * 8, *fields[i]);
+  }
+  link_wire_put32(out + 80, (uint32_t)(int32_t)llp);
+  link_wire_put32(out + 84, (uint32_t)(int32_t)rrp);
+  audio_link_header(out);
+  memcpy(out, "KRAUD001", 8);
+}
+
+void audio_rewind_load(const uint8 *in, unsigned int capacity)
+{
+  uint8 header[48];
+  unsigned int i, sizes[4], cursor = rewind_audio_header;
+  if (capacity < rewind_audio_header || memcmp(in, "KRAUD001", 8)) return;
+  audio_link_header(header);
+  if (memcmp(header + 8, in + 8, 40) || !sound_link_state_valid(in + 48, 16)) return;
+  for (i = 0; i < 4; i++)
+  {
+    sizes[i] = link_wire_get32(in + 64 + i * 4);
+    if (!!sizes[i] != !!snd.blips[i] || sizes[i] > capacity - cursor) return;
+    if (sizes[i] && !blip_link_state_valid(snd.blips[i], in + cursor, sizes[i])) return;
+    cursor += sizes[i];
+  }
+  if (config.filter & 2)
+  {
+    double *fields[32];
+    if (capacity - cursor < rewind_eq_bytes) return;
+    for (i = 0; i < 32; i++) if (!isfinite(link_wire_get_double(in + cursor + i * 8))) return;
+    audio_link_eq_fields(fields);
+    for (i = 0; i < 32; i++) *fields[i] = link_wire_get_double(in + cursor + i * 8);
+  }
+  cursor = rewind_audio_header;
+  for (i = 0; i < 4; i++)
+  {
+    if (sizes[i]) blip_link_state_load(snd.blips[i], in + cursor, sizes[i]);
+    cursor += sizes[i];
+  }
+  sound_link_state_load(in + 48, 16);
+  llp = (int16)link_wire_get_i32(in + 80);
+  rrp = (int16)link_wire_get_i32(in + 84);
+}
