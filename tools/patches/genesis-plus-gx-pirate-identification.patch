+/* Recognize the verified four-copy Super Poker dump without trimming ROM or
+ * duplicating its hardware entry. Compare repeats in either byte order; only
+ * the small canonical fingerprint needs conversion on little-endian hosts. */
+static uint32 md_cart_prefix_crc(const uint8 *rom, int native_order)
+{
+  uint8 block[1024];
+  uint32 crc = 0;
+  unsigned int offset, i;
+  for (offset = 0; offset < 0x10000; offset += sizeof(block))
+  {
+    for (i = 0; i < sizeof(block); i++)
+      block[i] = native_order ? READ_BYTE(rom, offset + i) : rom[offset + i];
+    crc = crc32(crc, block, sizeof(block));
+  }
+  return crc;
+}
+
+static int md_cart_poker_overdump(const uint8 *rom, size_t size, int native_order)
+{
+  if ((size != 0x400000) || (md_cart_prefix_crc(rom, native_order) != 0xdd02797c))
+    return 0;
+  return !memcmp(rom, rom + 0x100000, 0x100000) &&
+         !memcmp(rom, rom + 0x200000, 0x100000) &&
+         !memcmp(rom, rom + 0x300000, 0x100000);
+}
