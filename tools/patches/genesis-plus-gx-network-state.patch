+/* Network snapshots use the native GPX state, so restrict the contract to the
+ * audited x64 little-endian layout. It is intentionally independent of the OS,
+ * local binary hash and addresses. Bump it for deterministic behavior changes. */
+RETRO_API const char *retro_kegarefusion_network_state_abi(void)
+{
+#if defined(__x86_64__) && defined(HAVE_YM3438_CORE) && defined(HAVE_OPLL_CORE)
+   const uint16 endian = 1;
+   if (*(const uint8 *)&endian != 1 || sizeof(void *) != 8 || sizeof(int) != 4 ||
+       sizeof(double) != 8 || strcmp(STATE_VERSION, "GENPLUS-GX 1.7.6") ||
+       sizeof(Z80_Regs) != 88 || offsetof(Z80_Regs, daisy) != 72 ||
+       offsetof(Z80_Regs, irq_callback) != 80 || sizeof(cpu_idle_t) != 12 ||
+       sizeof(ssp1601_t) != 1280 || sizeof(ym3438_t) != 1252 ||
+       sizeof(opll_t) != 392 || offsetof(opll_t, patchrom) != 16 ||
+       sizeof(chan_t) != 16 || sizeof(reg16_t) != 2 ||
+       !YM2612NetworkLayout() || !YM2413NetworkLayout()) return NULL;
+   return "kegarefusion-network-state-v2-gpx-f27655b-x64le-32x-wire-v1";
+#else
+   return NULL;
+#endif
+}
