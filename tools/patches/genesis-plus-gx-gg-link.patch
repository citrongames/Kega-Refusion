+/* Kega Refusion Game Gear EXT cable and 8N1 UART, 2026.
+ * Derived from Sega's Game Gear Hardware Reference Manual, rev. 1, and
+ * Charles MacDonald's hardware-tested I/O notes. Same Genesis Plus GX
+ * noncommercial/source-distribution license as io_ctrl.c. No game patches.
+ * The host owns isolated modules and instruction-boundary cooperative clocks.
+ */
+#include "shared.h"
+
+void (*gg_link_yield)(void *, unsigned int) = 0;
+static void *gg_user;
+static uint8 *gg_peer;
+static struct {
+  uint32 tx_next, rx_next, tx_period, rx_period;
+  uint32 tx_shift, tx_index, rx_shift, rx_index;
+  uint32 tx_active, rx_active, tx_line, previous_rx, previous_th, nmi;
+} gg;
+
+static unsigned int gg_period(void)
+{
+  static const unsigned int baud[4] = {4800, 2400, 1200, 300};
+  unsigned int rate = baud[io_reg[5] >> 6];
+  return (MCLOCK_NTSC + rate / 2) / rate;
+}
+
+/* io_reg[7] is an otherwise unused GG register, published only while linked.
+ * Input-configured pins publish pull-ups. No peer pointer enters any state. */
+static void gg_publish(void)
+{
+  unsigned int pins = io_reg[1] | (io_reg[2] & 0x7f);
+  if (io_reg[5] & 0x10) pins = (pins & ~0x10) | (gg.tx_line << 4);
+  if (io_reg[5] & 0x20) pins |= 0x20;
+  io_reg[7] = pins & 0x7f;
+}
+
+static unsigned int gg_peer_pins(void)
+{
+  unsigned int p = gg_peer ? gg_peer[7] : 0x7f;
+  return ((p & 3) << 2) | ((p & 12) >> 2) |
+         ((p & 16) << 1) | ((p & 32) >> 1) | (p & 64);
+}
+
+/* The holding register can accept a byte while the shift register is on the wire. */
+static void gg_tx_start(unsigned int cycles)
+{
+  gg.tx_active = 1;
+  gg.tx_index = 0;
+  gg.tx_shift = io_reg[3];
+  gg.tx_period = gg_period();
+  gg.tx_next = cycles + gg.tx_period;
+  gg.tx_line = 0;
+  io_reg[5] &= ~1;
+}
+
+static void gg_tx_advance(unsigned int cycles)
+{
+  while (gg.tx_active && cycles >= gg.tx_next)
+  {
+    if (++gg.tx_index == 10)
+    {
+      if (io_reg[5] & 1)
+        gg_tx_start(gg.tx_next);
+      else
+      {
+        gg.tx_active = 0;
+        gg.tx_next = 0;
+        gg.tx_line = 1;
+      }
+    }
+    else
+    {
+      gg.tx_next += gg.tx_period;
+      gg.tx_line = gg.tx_index == 9 ? 1 : (gg.tx_shift >> (gg.tx_index - 1)) & 1;
+    }
+  }
+  gg_publish();
+}
+
+void gg_link_sync(unsigned int cycles)
+{
+  unsigned int pins, rx, th;
+  if (!gg_link_yield) return;
+  gg_tx_advance(cycles);
+  if (cycles >= io_link_deadline) gg_link_yield(gg_user, cycles);
+  pins = gg_peer_pins();
+  th = (pins >> 6) & 1;
+  if (gg.previous_th && !th && (io_reg[2] & 0xc0) == 0x40) gg.nmi = 1;
+  gg.previous_th = th;
+  rx = (pins >> 5) & 1;
+  if (io_reg[5] & 0x20)
+  {
+    if (!gg.rx_active && gg.previous_rx && !rx)
+    {
+      gg.rx_active = 1;
+      gg.rx_index = 0;
+      gg.rx_shift = 0;
+      gg.rx_period = gg_period();
+      gg.rx_next = cycles + gg.rx_period / 2;
+    }
+    while (gg.rx_active && cycles >= gg.rx_next)
+    {
+      gg.rx_next += gg.rx_period;
+      if (gg.rx_index == 0)
+      {
+        if (rx) {gg.rx_active = 0; gg.rx_next = 0; break;}
+      }
+      else if (gg.rx_index <= 8) gg.rx_shift |= rx << (gg.rx_index - 1);
+      else
+      {
+        /* A full receive latch is overwritten by the next completed byte.
+         * There is no separate UART overrun flag on the GG. */
+        io_reg[4] = gg.rx_shift;
+        io_reg[5] = (io_reg[5] & ~4) | 2 | (rx ? 0 : 4);
+        gg.rx_active = 0;
+        gg.rx_next = 0;
+        if (io_reg[5] & 8) gg.nmi = 1;
+      }
+      gg.rx_index++;
+    }
+  }
+  gg.previous_rx = rx;
+}
+
+void gg_link_reset(void)
+{
+  memset(&gg, 0, sizeof(gg));
+  gg.tx_line = gg.previous_rx = gg.previous_th = 1;
+  if (gg_link_yield)
+  {
+    gg_publish();
+    gg.previous_rx = (gg_peer_pins() >> 5) & 1;
+    gg.previous_th = (gg_peer_pins() >> 6) & 1;
+  }
+}
+
+void gg_link_connect(uint8 *peer, void (*yield)(void *, unsigned int), void *user)
+{
+  gg_peer = peer && yield && system_hw == SYSTEM_GG ? peer : 0;
+  gg_link_yield = gg_peer ? yield : 0;
+  gg_user = gg_peer ? user : 0;
+  gg_link_reset();
+  /* Reconnect follows native restoration: its UART status must survive until
+   * the separately saved shift registers and deadlines have been restored. */
+  if (!gg_peer && system_hw == SYSTEM_GG) io_reg[5] &= 0xf8;
+}
+
+unsigned int gg_link_nmi(void)
+{
+  unsigned int pending = gg.nmi;
+  gg.nmi = 0;
+  return pending;
+}
+
+void gg_link_end_frame(unsigned int cycles)
+{
+  /* CPU instructions can overrun the frame boundary. Advance before rebasing. */
+  gg_link_sync(Z80.cycles);
+  if (gg.tx_active) gg.tx_next -= cycles;
+  if (gg.rx_active) gg.rx_next -= cycles;
+}
+
+unsigned int gg_link_read(unsigned int offset)
+{
+  unsigned int direction, result;
+  gg_link_sync(Z80.cycles);
+  if (offset == 1)
+  {
+    direction = io_reg[2] & 0x7f;
+    if (io_reg[5] & 0x10) direction &= ~0x10;
+    if (io_reg[5] & 0x20) direction |= 0x20;
+    result = (io_reg[7] & ~direction) | (gg_peer_pins() & direction);
+    return (io_reg[1] & 0x80) | result;
+  }
+  result = io_reg[offset];
+  if (offset == 4) io_reg[5] &= ~6;
+  return result;
+}
+
+void gg_link_write(unsigned int offset, unsigned int data)
+{
+  gg_link_sync(Z80.cycles);
+  if (offset == 3)
+  {
+    io_reg[3] = data;
+    if (io_reg[5] & 0x10)
+    {
+      if (gg.tx_active) io_reg[5] |= 1;
+      else gg_tx_start(Z80.cycles);
+    }
+  }
+  else if (offset == 5)
+  {
+    io_reg[5] = (data & 0xf8) | (io_reg[5] & 7);
+    if (!(data & 0x10))
+    {
+      gg.tx_active = 0; gg.tx_next = 0; gg.tx_line = 1;
+      io_reg[5] &= ~1;
+    }
+    if (!(data & 0x20)) {gg.rx_active = 0; gg.rx_next = 0;}
+  }
+  else io_reg[offset] = data;
+  gg_publish();
+}
+
+/* KRGGL002: fixed 80-byte little-endian extension, after each native state.
+ * Restore after BOTH native states and BOTH reconnects. Loading never samples
+ * the peer, yields, or fires an interrupt, so endpoint restore order is free. */
+unsigned int gg_link_state_size(void) {return system_hw == SYSTEM_GG ? 80 : 0;}
+
+static void gg_put32(uint8 *p, uint32 value)
+{
+  p[0] = value; p[1] = value >> 8; p[2] = value >> 16; p[3] = value >> 24;
+}
+static uint32 gg_get32(const uint8 *p)
+{
+  return p[0] | ((uint32)p[1] << 8) | ((uint32)p[2] << 16) | ((uint32)p[3] << 24);
+}
+
+int gg_link_state_save(uint8 *out, unsigned int size)
+{
+  const uint32 fields[14] = {gg.tx_next, gg.rx_next, gg.tx_period, gg.rx_period,
+    gg.tx_shift, gg.tx_index, gg.rx_shift, gg.rx_index, gg.tx_active,
+    gg.rx_active, gg.tx_line, gg.previous_rx, gg.previous_th, gg.nmi};
+  unsigned int i;
+  if (!out || size != 80 || !gg_link_yield || system_hw != SYSTEM_GG) return 0;
+  memset(out, 0, size); memcpy(out, "KRGGL002", 8);
+  for (i = 0; i < 14; i++) gg_put32(out + 8 + i * 4, fields[i]);
+  memcpy(out + 64, io_reg, 8);
+  return 1;
+}
+
+int gg_link_state_load(const uint8 *in, unsigned int size)
+{
+  uint32 f[14]; unsigned int i;
+  int legacy;
+  if (!in || size != 80 || !gg_link_yield || system_hw != SYSTEM_GG) return 0;
+  legacy = !memcmp(in, "KRGGL001", 8);
+  if (!legacy && memcmp(in, "KRGGL002", 8)) return 0;
+  for (i = 0; i < 14; i++) f[i] = gg_get32(in + 8 + i * 4);
+  for (i = 8; i < 14; i++) if (f[i] > 1) return 0;
+  if (f[4] > 255 || f[5] > 10 || f[6] > 255 || f[7] > 10 ||
+      (f[8] && (!f[0] || f[0] > 3000000 || f[2] < 11000 || f[2] > 180000)) ||
+      (f[9] && (!f[1] || f[1] > 3000000 || f[3] < 11000 || f[3] > 180000)) ||
+      ((!f[8]) && f[0]) || ((!f[9]) && f[1]) ||
+      ((in[69] & 1) && !f[8]) || (legacy && !!(in[69] & 1) != f[8])) return 0;
+  for (i = 72; i < 80; i++) if (in[i]) return 0;
+  /* The registers accompany the extension to reject mismatched native states.
+   * io_reg[0] is a derived region/mode register and is validated by native load. */
+  if (memcmp(in + 65, io_reg + 1, 6)) return 0;
+  if (legacy) io_reg[5] &= ~1; /* v1 had no holding register. */
+  gg.tx_next=f[0]; gg.rx_next=f[1]; gg.tx_period=f[2]; gg.rx_period=f[3];
+  gg.tx_shift=f[4]; gg.tx_index=f[5]; gg.rx_shift=f[6]; gg.rx_index=f[7];
+  gg.tx_active=f[8]; gg.rx_active=f[9]; gg.tx_line=f[10];
+  gg.previous_rx=f[11]; gg.previous_th=f[12]; gg.nmi=f[13];
+  gg_publish();
+  return 1;
+}
