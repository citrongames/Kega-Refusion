 /* Cached decoded sector-zero data. Does not seek or disturb the live drive. */
 static uint8 achievement_header[512];
 static int achievement_header_valid;
+/* Content-derived compatibility, not serialized drive state. Cleared on every
+ * mount/unmount. Only the known old Road Rash executable gets this exception. */
+static int legacy_roadrash = -1;
+int cdd_legacy_roadrash(void)
+{
+  uint8 sector[2048];
+  unsigned long crc;
+  int saved_lba, saved_index, i;
+  if (legacy_roadrash >= 0) return legacy_roadrash;
+  legacy_roadrash = 0;
+  if (!cdd.loaded || !achievement_header_valid || kr_megald_active ||
+      !cdd.toc.tracks[0].type || cdd.toc.tracks[0].end < 65 ||
+      memcmp(achievement_header + 0x100, "SEGA CD Loader  ", 16)) return 0;
+  saved_lba = cdd.lba;
+  saved_index = cdd.index;
+  cdd.index = 0;
+  cdd.lba = 36;
+  memset(sector, 0, sizeof(sector));
+  cdd_read_data(sector, NULL);
+  /* Quick reject on the offending code sector before checking all APP.BIN.
+   * CRCs are over logical Mode 1 bytes, so CUE/BIN, ISO and CHD agree. */
+  if (crc32(0, sector, sizeof(sector)) == 0xea789aaeUL)
+  {
+    crc = 0;
+    for (i = 26; i < 65; ++i)
+    {
+      cdd.lba = i;
+      memset(sector, 0, sizeof(sector));
+      cdd_read_data(sector, NULL);
+      crc = crc32(crc, sector, sizeof(sector));
+    }
+    legacy_roadrash = (crc == 0x7e749148UL);
+  }
+  cdd.lba = saved_lba;
+  cdd.index = saved_index;
+  return legacy_roadrash;
+}
