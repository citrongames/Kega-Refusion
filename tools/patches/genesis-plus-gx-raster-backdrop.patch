+void backdrop_frame(int draw)
+{
+  backdrop_video = draw;
+  backdrop_dma_active = 0;
+  raster_last_line = raster_rows[0].line = raster_rows[1].line = -1;
+}
+
+/* Build once from the actual horizontal counter, including the longer H40
+ * sync clocks. A refresh costs both the refresh slot and its source read.
+ * H40 positions follow hardware measurements; H32 blank refresh phases
+ * are approximate (five refreshes per line). */
+static void backdrop_slots(int h40)
+{
+  int n = 0, t;
+  for (t = 0; t < MCYCLES_PER_LINE; ++t)
+  {
+    int h = hctab[t];
+    if (t && h == hctab[t - 1]) continue;
+    /* H40 jumps from dot $16C to $1C9 halfway through one slot. */
+    if (h40 && h == 0xe4) continue;
+    int refresh_pair = h40 ?
+      ((h >= 26 && h <= 155 && ((h - 26) & 31) <= 1) || h == 250 || h == 251) :
+      ((h >= 19 && h <= 116 && ((h - 19) & 31) <= 1) || h == 243 || h == 244);
+    if (!refresh_pair && n < BACKDROP_WORDS) raster_slot[h40][n++] = t;
+  }
+  raster_slot_count[h40] = n;
+}
+
+void backdrop_dma_begin(unsigned int cycle)
+{
+  int h40 = reg[12] & 1;
+  if (!raster_slot_count[h40]) backdrop_slots(h40);
+  raster_first = 0;
+  while (raster_first < raster_slot_count[h40] && raster_slot[h40][raster_first] < cycle)
+    ++raster_first;
+  raster_count = 0;
+  backdrop_dma_active = 1;
+  raster_words[0] = pixel[0x40];
+}
+
+void backdrop_dma_sample(void)
+{
+  raster_words[++raster_count] = pixel[0x40];
+}
+
+/* A scheduler line starts in the right edge of the preceding picture row.
+ * Join that tail to its own row, including the optional horizontal border. */
+static void paint_backdrop(int line, int origin, int period, int slots, const unsigned short *at)
+{
+  int x, i = 0;
+  int border_x = bitmap.viewport.x;
+  int width = bitmap.viewport.w;
+  if (line < 0 || line >= bitmap.viewport.h || width > 320 || border_x < 0 || border_x > 32) return;
+  int bank = line & 1;
+  int left = -border_x;
+  int end = width + border_x;
+  if (origin < 0)
+  {
+    if (at[0] > origin + (end - 1) * period) return;
+    int first = (-origin + period - 1) / period;
+    if (first > left) left = first;
+  }
+  if (left >= end) return;
+  if (raster_rows[bank].line != line)
+  {
+    raster_rows[bank].line = line;
+    for (x = 0; x < BACKDROP_WIDTH; ++x) raster_rows[bank].pixels[x] = raster_words[0];
+  }
+  else if (raster_first > 0)
+  {
+    /* Keep the already painted prefix when a second DMA starts mid-row. */
+    int first = (at[0] - origin + period - 1) / period;
+    if (first > left) left = first;
+  }
+  for (x = left; x < end; ++x)
+  {
+    int sample = origin + x * period;
+    while (i < slots && at[i] <= sample) ++i;
+    raster_rows[bank].pixels[x + 32] = raster_words[i];
+  }
+  if (raster_last_line == line) remap_line(line);
+}
+
+void backdrop_dma_end(void)
+{
+  int h40 = reg[12] & 1;
+  int slots = raster_slot_count[h40] - raster_first;
+  backdrop_dma_active = 0;
+  if (slots > raster_count) slots = raster_count;
+  if (!slots) return;
+  int changed = 0;
+  while (changed < slots && raster_words[changed + 1] == raster_words[0]) ++changed;
+  /* A palette upload that never changes the backdrop needs no raster row,
+   * unless an earlier burst on that row already recorded another colour. */
+  if (changed == slots && raster_rows[v_counter & 1].line != v_counter &&
+      !(v_counter > 0 && raster_rows[(v_counter - 1) & 1].line == v_counter - 1)) return;
+  const unsigned short *at = raster_slot[h40] + raster_first;
+  /* Start of active output in hvc.h (MCLK from HINT). */
+  int origin = h40 ? 988 : 1000;
+  int period = h40 ? 8 : 10;
+  paint_backdrop(v_counter - 1, origin - MCYCLES_PER_LINE, period, slots, at);
+  paint_backdrop(v_counter, origin, period, slots, at);
+}
+
+static const PIXEL_OUT_T *resolve_backdrop(int line, const uint8 *src,
+                                          const PIXEL_OUT_T *palette, int width)
+{
+  if (width < 1 || width > BACKDROP_WIDTH || bitmap.viewport.x < 0 || bitmap.viewport.x > 32) return NULL;
+  const PIXEL_OUT_T *backdrop = raster_rows[line & 1].pixels + 32 - bitmap.viewport.x;
+  for (int x = 0; x < width; ++x)
+    raster_output[x] = (src[x] & 15) ? palette[src[x]] : backdrop[x];
+  return raster_output;
+}
