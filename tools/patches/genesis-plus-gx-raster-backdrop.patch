+/* Blanked Mode 5 still drives the DAC from CRAM. The transfer engine owns
+ * the actual reads and CRAM writes; this small side buffer only describes
+ * what was on the wire while those writes took place. */
+enum { BACKDROP_WORDS = 198, BACKDROP_WIDTH = 320 + 2 * 32 };
+static struct {
+  int line;
+  PIXEL_OUT_T pixels[BACKDROP_WIDTH];
+} raster_rows[2];
+static PIXEL_OUT_T raster_output[BACKDROP_WIDTH];
+static PIXEL_OUT_T raster_words[BACKDROP_WORDS + 1];
+static unsigned short raster_slot[2][BACKDROP_WORDS];
+static int raster_slot_count[2];
+static int raster_first, raster_count, raster_last_line;
