+
+int blip_link_state_save(const blip_t *buf, unsigned char *out, unsigned size)
+{
+#ifndef BLIP_MONO
+  unsigned c, i;
+  if (!buf || !out || size != blip_link_state_size() || size != 168 ||
+      buf->size < buf_extra || blip_samples_avail(buf) != 0) return 0;
+  link_wire_put64(out, (uint64_t)buf->factor);
+  link_wire_put64(out + 8, (uint64_t)buf->offset);
+  for (c = 0; c < 2; c++)
+  {
+    link_wire_put32(out + 16 + c * 4, (uint32_t)buf->integrator[c]);
+    for (i = 0; i < buf_extra; i++)
+      link_wire_put32(out + 24 + (c * buf_extra + i) * 4, (uint32_t)buf->buffer[c][i]);
+  }
+  return 1;
+#else
+  return 0;
+#endif
+}
+
+int blip_link_state_valid(const blip_t *buf, const unsigned char *in, unsigned size)
+{
+#ifndef BLIP_MONO
+  return buf && in && size == 168 && size == blip_link_state_size() &&
+    buf->size >= buf_extra && link_wire_get64(in) == (uint64_t)buf->factor &&
+    link_wire_get64(in + 8) < (uint64_t)time_unit;
+#else
+  return 0;
+#endif
+}
+
+int blip_link_state_load(blip_t *buf, const unsigned char *in, unsigned size)
+{
+#ifndef BLIP_MONO
+  unsigned c, i;
+  if (!blip_link_state_valid(buf, in, size)) return 0;
+  buf->offset = (fixed_t)link_wire_get64(in + 8);
+  for (c = 0; c < 2; c++)
