+/* Kega Refusion link audio extension: canonical little-endian scalar encoding.
+ * Original integration code, under the Genesis Plus GX default license.
+ * No native structs, pointer values, or machine-sized long values enter the wire. */
+#ifndef KEGAREFUSION_LINK_STATE_H
+#define KEGAREFUSION_LINK_STATE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <float.h>
+
+static inline void link_wire_put32(unsigned char *out, uint32_t value)
+{
+  unsigned i;
+  for (i = 0; i < 4; i++) out[i] = (unsigned char)(value >> (i * 8));
+}
+static inline uint32_t link_wire_get32(const unsigned char *in)
+{
+  uint32_t value = 0; unsigned i;
+  for (i = 0; i < 4; i++) value |= (uint32_t)in[i] << (i * 8);
+  return value;
+}
+static inline void link_wire_put64(unsigned char *out, uint64_t value)
+{
+  unsigned i;
+  for (i = 0; i < 8; i++) out[i] = (unsigned char)(value >> (i * 8));
+}
+static inline uint64_t link_wire_get64(const unsigned char *in)
+{
+  uint64_t value = 0; unsigned i;
+  for (i = 0; i < 8; i++) value |= (uint64_t)in[i] << (i * 8);
+  return value;
+}
+static inline int32_t link_wire_get_i32(const unsigned char *in)
+{
+  uint32_t value = link_wire_get32(in); int32_t result;
+  memcpy(&result, &value, 4);
+  return result;
+}
+static inline void link_wire_put_double(unsigned char *out, double value)
+{
+  uint64_t bits; memcpy(&bits, &value, 8); link_wire_put64(out, bits);
+}
+static inline double link_wire_get_double(const unsigned char *in)
+{
+  uint64_t bits = link_wire_get64(in); double value;
+  memcpy(&value, &bits, 8); return value;
+}
+#endif
