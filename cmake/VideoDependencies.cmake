# Both platforms use the same pinned, recording-only FFmpeg build.
# Do not reuse KEGA_VIDEO_ROOT / KEGA_VIDEO_RUNTIME_DIR from older CMake caches:
# those selected Qt's full Windows FFmpeg or an unrelated system installation.
add_library(kega_video_deps INTERFACE)
if(WIN32)
    set(_video_platform windows)
else()
    set(_video_platform linux)
endif()
set(KEGA_VIDEO_MINIMAL_ROOT "${CMAKE_SOURCE_DIR}/build/deps/video-minimal/${_video_platform}"
    CACHE PATH "Pinned minimal FFmpeg prepared by tools/prepare-video.py")
if(NOT EXISTS "${KEGA_VIDEO_MINIMAL_ROOT}/build-manifest.json")
    message(FATAL_ERROR "Missing minimal FFmpeg. Run: python3 tools/prepare-video.py --platform ${_video_platform}")
endif()
if(WIN32)
    set(KEGA_VIDEO_RUNTIME_DIR "${KEGA_VIDEO_MINIMAL_ROOT}/bin")
else()
    set(KEGA_VIDEO_RUNTIME_DIR "${KEGA_VIDEO_MINIMAL_ROOT}/lib")
endif()
foreach(_pair IN ITEMS "avformat;61" "avcodec;61" "avutil;59")
    list(GET _pair 0 _name)
    list(GET _pair 1 _major)
    if(WIN32)
        set(_runtime "${KEGA_VIDEO_RUNTIME_DIR}/${_name}-${_major}.dll")
        set(_implib "${KEGA_VIDEO_MINIMAL_ROOT}/lib/lib${_name}.dll.a")
    else()
        set(_runtime "${KEGA_VIDEO_RUNTIME_DIR}/lib${_name}.so.${_major}")
    endif()
    if(NOT EXISTS "${_runtime}" OR
       NOT EXISTS "${KEGA_VIDEO_MINIMAL_ROOT}/include/lib${_name}/version.h")
        message(FATAL_ERROR "Incomplete minimal FFmpeg installation: ${KEGA_VIDEO_MINIMAL_ROOT}")
    endif()
    add_library(kega_video_${_name} SHARED IMPORTED)
    set_target_properties(kega_video_${_name} PROPERTIES
        IMPORTED_LOCATION "${_runtime}"
        INTERFACE_INCLUDE_DIRECTORIES "${KEGA_VIDEO_MINIMAL_ROOT}/include")
    if(WIN32)
        if(NOT EXISTS "${_implib}")
            message(FATAL_ERROR "Missing minimal FFmpeg import library: ${_implib}")
        endif()
        set_target_properties(kega_video_${_name} PROPERTIES IMPORTED_IMPLIB "${_implib}")
    else()
        set_target_properties(kega_video_${_name} PROPERTIES
            IMPORTED_SONAME "lib${_name}.so.${_major}")
    endif()
    target_link_libraries(kega_video_deps INTERFACE kega_video_${_name})
endforeach()
